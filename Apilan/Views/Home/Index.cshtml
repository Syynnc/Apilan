@{
    ViewData["Title"] = "Event registration & attendance for student orgs";
    Layout = "_LayoutPublic";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}

@* ============================================================ HERO ======= *@
<section class="hero">
    <div class="shell hero-grid">

        <div class="hero-copy">
            <span class="hero-tag">
                <b>For student orgs</b>
                Registration · Attendance · Certificates
            </span>

            <h1>Stop taking attendance on a <em>sign-in sheet</em>.</h1>

            <p class="hero-lede">
                Officers publish the event. Members register with a link and get a
                check-in code. At the door you record attendance in seconds — and the
                certificates and the post-activity report come out of the same records.
            </p>

            <div class="hero-cta">
                <a class="btn-a lg" href="#calendar">See the calendar</a>
                <a class="btn-a ghost lg" href="#how">How it works</a>
            </div>

            <ul class="hero-facts">
                <li>Time-in and time-out per session</li>
                <li>Slots, waitlist, and walk-ins</li>
                <li>Eligibility computed from attendance</li>
            </ul>
        </div>

        @* ---- The artifact the system produces, and the door it goes through ---- *@
        <div class="hero-visual">
            @await Html.PartialAsync("_Ticket", new TicketViewModel
            {
                Org = "CCS Student Council",
                Title = "Tech Night 2026",
                TypeKey = "talk", TypeLabel = "Seminar",
                StartsAt = new DateTime(2026, 10, 2, 17, 0, 0),
                EndsAt = new DateTime(2026, 10, 2, 20, 0, 0),
                Venue = "AVR 2, Main Building",
                Session = "Single session",
                RegistrantName = "Mara Villanueva",
                StudentNo = "2022-04417",
                Code = "APL-7K2M",
                Status = TicketStatus.Confirmed,
                Interactive = true
            })

            <aside class="door-card" aria-label="Attendance in progress">
                <div class="door-head">
                    <span>Door · Tech Night</span>
                    <span class="state">Open</span>
                </div>

                <div class="door-count">
                    <span class="n" data-count>0</span>
                    <span class="of">/ 180 registered</span>
                </div>

                <div class="door-bar" role="img" aria-label="Attendance progress">
                    <i data-bar></i>
                </div>

                <ul class="door-feed" data-feed aria-live="polite"></ul>
            </aside>
        </div>

    </div>
</section>

@* ============================================================ TYPES ====== *@
<div class="types">
    <div class="shell inner">
        <span class="lbl">Built around what orgs actually run</span>
        <span class="code-tag">General assembly</span>
        <span class="code-tag">Seminar</span>
        <span class="code-tag">Workshop</span>
        <span class="code-tag">Leadership training</span>
        <span class="code-tag">Outreach</span>
        <span class="code-tag">Org week</span>
        <span class="code-tag">Recollection</span>
    </div>
</div>

@* ============================================================ CALENDAR == *@
<section class="section" id="calendar">
    <div class="shell">
        <div class="section-head reveal">
            <span class="eyebrow">The semester at a glance</span>
            <h2>One calendar the whole org works from.</h2>
            <p>
                Every published event lands here with its slots and status. Pick a date
                to see what is running and how registration is filling up.
            </p>
            <a class="btn-a" style="margin-top:var(--s-5)" asp-controller="Calendar" asp-action="Index">
                Open the live calendar
            </a>
        </div>

        <div class="cal-layout reveal">

            <div class="cal" data-cal
                 data-cal-feed="@Url.Action("Feed", "Calendar")"
                 data-cal-detail="@Url.Action("Details", "Calendar")">
                <div class="cal-bar">
                    <h3 class="cal-month" data-cal-month>October<span>2026</span></h3>
                    <button type="button" class="cal-step" data-cal-prev aria-label="Previous month">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M15 5 L8 12 L15 19" />
                        </svg>
                    </button>
                    <button type="button" class="cal-step" data-cal-next aria-label="Next month">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 5 L16 12 L9 19" />
                        </svg>
                    </button>
                </div>

                <div class="cal-dow" aria-hidden="true">
                    <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span>
                    <span>Thu</span><span>Fri</span><span>Sat</span>
                </div>

                <div class="cal-grid" data-cal-grid role="grid" aria-label="Org event calendar"></div>

                <div class="cal-legend">
                    <span><i style="background:var(--accent)"></i> Talk / session</span>
                    <span><i style="background:var(--mango)"></i> Workshop</span>
                    <span><i style="background:var(--gold)"></i> Assembly</span>
                    <span><i style="background:var(--rose)"></i> Outreach</span>
                    <span><i style="background:var(--teal)"></i> Training</span>
                </div>
            </div>

            <aside class="cal-detail">
                <div class="d-head">
                    <div class="d-dow" data-detail-dow></div>
                    <h3 class="d-date" data-detail-date></h3>
                </div>
                <div class="cal-body" data-cal-body></div>
            </aside>

        </div>

        <noscript>
            <p class="muted" style="margin-top:var(--s-5)">
                This calendar needs JavaScript. The same month, rendered by the server,
                is at <a asp-controller="Calendar" asp-action="Month">the calendar page</a>.
            </p>
        </noscript>
    </div>
</section>

@* ============================================================ STUBS ===== *@
<section class="section" id="stubs">
    <div class="shell">
        <div class="section-head reveal">
            <span class="eyebrow">What a registration produces</span>
            <h2>Every sign-up prints a stub.</h2>
            <p>
                One component, every event type and every registration state. The month
                the event falls in is printed faintly behind it, with its own date ringed.
            </p>
        </div>

        <div class="ticket-row reveal">
            @await Html.PartialAsync("_Ticket", new TicketViewModel
            {
                Org = "CCS Student Council",
                Title = "General Assembly",
                TypeKey = "assembly", TypeLabel = "General Assembly",
                StartsAt = new DateTime(2026, 10, 14, 15, 0, 0),
                EndsAt = new DateTime(2026, 10, 14, 17, 30, 0),
                Venue = "Gymnasium",
                Session = "Day 1 of 2",
                RegistrantName = "Job Dela Cruz",
                StudentNo = "2023-01188",
                Code = "APL-3XQ9",
                Status = TicketStatus.CheckedIn
            })

            @await Html.PartialAsync("_Ticket", new TicketViewModel
            {
                Org = "CCS Student Council",
                Title = "Résumé Workshop",
                TypeKey = "workshop", TypeLabel = "Workshop",
                StartsAt = new DateTime(2026, 10, 9, 13, 0, 0),
                EndsAt = new DateTime(2026, 10, 9, 16, 0, 0),
                Venue = "Computer Lab 3",
                Session = "Single session",
                RegistrantName = "Aliyah Ramos",
                StudentNo = "2022-09043",
                Code = "APL-P8VD",
                Status = TicketStatus.Confirmed
            })

            @await Html.PartialAsync("_Ticket", new TicketViewModel
            {
                Org = "CCS Student Council",
                Title = "Leadership Training",
                TypeKey = "training", TypeLabel = "Training",
                StartsAt = new DateTime(2026, 10, 23, 8, 0, 0),
                EndsAt = new DateTime(2026, 10, 23, 17, 0, 0),
                Venue = "Function Hall",
                Session = "Whole day",
                RegistrantName = "Kier Tolentino",
                StudentNo = "2021-07725",
                Code = "APL-M4TB",
                Status = TicketStatus.Waitlisted
            })
        </div>

        <p class="ticket-caption reveal">
            Left to right — already checked in, confirmed, waitlisted. The spine colour
            is the event type; the chip is the registration state.
        </p>
    </div>
</section>

@* ============================================================ HOW ======== *@
<section class="section" id="how">
    <div class="shell">
        <div class="section-head reveal">
            <span class="eyebrow">The whole loop</span>
            <h2>Four steps, start to certificate.</h2>
            <p>The same flow your org already follows on paper — minus the sign-up sheet that goes missing.</p>
        </div>

        <div class="steps">
            <article class="step reveal" style="--d:0ms">
                <span class="num" aria-hidden="true"></span>
                <h4>Officers publish</h4>
                <p>Set the details, slots, and schedule. Save as draft, publish when ready.</p>
            </article>
            <article class="step reveal" style="--d:80ms">
                <span class="num" aria-hidden="true"></span>
                <h4>Members register</h4>
                <p>One link. They get a confirmation code and a stub they can show at the door.</p>
            </article>
            <article class="step reveal" style="--d:160ms">
                <span class="num" aria-hidden="true"></span>
                <h4>You check them in</h4>
                <p>Scan or type the code. Time-in, time-out, duplicates caught automatically.</p>
            </article>
            <article class="step reveal" style="--d:240ms">
                <span class="num" aria-hidden="true"></span>
                <h4>Reports &amp; certificates</h4>
                <p>Eligibility computes itself from attendance. Export the participation report.</p>
            </article>
        </div>
    </div>
</section>

@* ============================================================ KIOSK ====== *@
<section class="section" id="checkin">
    <div class="shell kiosk-demo">

        <div class="reveal">
            <span class="eyebrow">At the door</span>
            <h2>The part that usually ruins the event.</h2>
            <p class="muted">
                No more passing a clipboard down a row of 180 people. One screen, one
                code, and the attendance record is already saved.
            </p>

            <ul class="demo-notes">
                <li><span class="k" aria-hidden="true">1</span><span>Works with a barcode scanner, a phone camera, or plain typing.</span></li>
                <li><span class="k" aria-hidden="true">2</span><span>A second scan records time-out instead of a duplicate entry.</span></li>
                <li><span class="k" aria-hidden="true">3</span><span>Walk-ins can be registered on the spot by an officer.</span></li>
                <li><span class="k" aria-hidden="true">4</span><span>Unrecognised codes are rejected clearly, not silently.</span></li>
            </ul>
        </div>

        <div class="kiosk reveal" data-kiosk>
            <div class="kiosk-brand">
                <svg class="tally sm on-dark" viewBox="0 0 26 24" aria-hidden="true">
                    <line x1="4"  y1="5" x2="4"  y2="19" />
                    <line x1="9"  y1="5" x2="9"  y2="19" />
                    <line x1="14" y1="5" x2="14" y2="19" />
                    <line x1="19" y1="5" x2="19" y2="19" />
                    <line class="slash" x1="1.5" y1="18.5" x2="21.5" y2="5.5" />
                </svg>
                Check-in · Tech Night 2026
            </div>

            <div class="kiosk-code" data-kiosk-code></div>

            <div class="kiosk-result" data-kiosk-result>
                <svg class="kiosk-seal" viewBox="0 0 40 40" aria-hidden="true">
                    <circle cx="20" cy="20" r="17" />
                    <path d="M13 20.5 L18 25.5 L27.5 15" />
                </svg>
                <div class="who" data-kiosk-who></div>
                <span class="verdict" data-kiosk-verdict></span>
            </div>
        </div>

    </div>
</section>

@* ============================================================ REPORT ===== *@
<section class="section" id="reports">
    <div class="shell">
        <div class="section-head reveal">
            <span class="eyebrow">After the event</span>
            <h2>The report is already written.</h2>
            <p>
                Attendance is data, not a photo of a sign-in sheet — so the numbers
                your adviser asks for are there when the event ends.
            </p>
        </div>

        <div class="report reveal">

            <div class="report-head">
                <div>
                    <div class="doc">Post-activity report</div>
                    <h3>General Assembly 2026</h3>
                </div>
                <div class="ref">
                    <b>CCS Student Council</b>
                    14–15 Oct 2026
                </div>
            </div>

            <div class="report-body">

                <div class="report-block">
                    <div class="report-label">Turnout by session</div>
                    <div class="bars" aria-hidden="true">
                        <i style="--h:64%; --i:0"></i><i style="--h:82%; --i:1"></i>
                        <i style="--h:57%; --i:2"></i><i style="--h:91%; --i:3"></i>
                        <i style="--h:73%; --i:4"></i><i style="--h:100%; --i:5"></i>
                    </div>
                    <div class="bars-axis" aria-hidden="true">
                        <span>D1 AM</span><span>D1 PM</span><span>D1 EVE</span>
                        <span>D2 AM</span><span>D2 PM</span><span>D2 EVE</span>
                    </div>

                    <div class="report-stats">
                        <div class="rstat">
                            <span class="n">400</span>
                            <span class="l">Registered</span>
                        </div>
                        <div class="rstat accent">
                            <span class="n">312</span>
                            <span class="l">Attended</span>
                        </div>
                    </div>
                </div>

                <div class="report-block">
                    <div class="report-label">Certificate eligibility</div>
                    <div class="ring-wrap">
                        <svg class="ring" viewBox="0 0 84 84" aria-hidden="true">
                            <circle class="track" cx="42" cy="42" r="36" />
                            <circle class="fill" cx="42" cy="42" r="36" />
                        </svg>
                        <div class="ring-mid" aria-hidden="true">77%</div>
                    </div>
                    <div class="metric-label">142 of 184 attendees qualify</div>
                </div>

            </div>

            <div class="report-foot">
                <span class="sig">Generated 15 Oct 2026</span>
                <span class="report-exports">
                    <a class="btn-a ghost sm" href="#reports">Export Excel</a>
                    <a class="btn-a ghost sm" href="#reports">Export PDF</a>
                </span>
            </div>

        </div>

        <div class="strip reveal">
            <div>
                <span class="si" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2.2"/><path d="M5.5 16.5c.9-1.6 2-2.4 3.5-2.4s2.6.8 3.5 2.4M15 10h4M15 13.5h4"/></svg>
                </span>
                <div>
                    <h4>Member records</h4>
                    <p>One record per member, with their full event history.</p>
                </div>
            </div>
            <div>
                <span class="si" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="7" y="6" width="14" height="14" rx="2"/><path d="M17 3H5a2 2 0 0 0-2 2v12M11 10v4M11 14h4"/></svg>
                </span>
                <div>
                    <h4>Multi-day sessions</h4>
                    <p>Separate time-in and time-out on every session.</p>
                </div>
            </div>
            <div>
                <span class="si" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="7" cy="6" r="2.4"/><circle cx="7" cy="12" r="2.4"/><circle cx="7" cy="18" r="2.4"/><path d="M12 6h8M12 12h8M12 18h5"/></svg>
                </span>
                <div>
                    <h4>Slots &amp; waitlist</h4>
                    <p>Cap registration and promote from the waitlist.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ============================================================ ROLES ===== *@
<section class="section" id="roles">
    <div class="shell">
        <div class="section-head reveal">
            <span class="eyebrow">Who sees what</span>
            <h2>One sign-in, three different apps.</h2>
            <p>Everyone comes in the same door and lands somewhere built for their job.</p>
        </div>

        <div class="screens">

            <div class="screen-set reveal">
                <div class="screen">
                    <div class="screen-bar">
                        <span class="screen-role">Member</span>
                        <span class="screen-route">/my/events</span>
                    </div>
                    <div class="screen-body">
                        <span class="mini-label">My events</span>

                        <div class="mini-row">
                            <div class="t">Tech Night 2026</div>
                            <span class="r chip ok">Attended</span>
                        </div>

                        <div class="mini-row">
                            <div class="t">Résumé Workshop</div>
                            <span class="r chip info">Registered</span>
                        </div>

                        <div class="mini-note">1 certificate ready</div>
                    </div>
                </div>

                <ul class="screen-can">
                    <li>Register for open events</li>
                    <li>Keep a stub with a check-in code</li>
                    <li>Download certificates</li>
                </ul>
            </div>

            <div class="screen-set reveal" style="--d:80ms">
                <div class="screen">
                    <div class="screen-bar">
                        <span class="screen-role">Officer</span>
                        <span class="screen-route">/officer/dashboard</span>
                    </div>
                    <div class="screen-body">
                        <span class="mini-label">Checked in · Tech Night</span>

                        <div>
                            <span class="mini-big">128</span>
                            <span class="mini-of"> / 180</span>
                        </div>
                        <div class="mini-bar" aria-hidden="true"><i style="width:71%"></i></div>

                        <div class="mini-row">
                            <div class="t">Pending approvals</div>
                            <span class="r chip warn">6</span>
                        </div>

                        <div class="mini-note">Next: General Assembly</div>
                    </div>
                </div>

                <ul class="screen-can">
                    <li>Create and publish events</li>
                    <li>Manage registrants and waitlist</li>
                    <li>Run the door, close the report</li>
                </ul>
            </div>

            <div class="screen-set reveal" style="--d:160ms">
                <div class="screen">
                    <div class="screen-bar">
                        <span class="screen-role">Admin</span>
                        <span class="screen-route">/admin/members</span>
                    </div>
                    <div class="screen-body">
                        <span class="mini-label">Member records</span>

                        <div class="mini-row">
                            <div class="t">Villanueva, Mara</div>
                            <span class="r chip ok">Active</span>
                        </div>

                        <div class="mini-row">
                            <div class="t">Dela Cruz, Job</div>
                            <span class="r chip ok">Active</span>
                        </div>

                        <div class="mini-note">486 members</div>
                    </div>
                </div>

                <ul class="screen-can">
                    <li>Member records and bulk import</li>
                    <li>Officer accounts and roles</li>
                    <li>Org-wide reports</li>
                </ul>
            </div>

        </div>
    </div>
</section>
@* ============================================================ CTA ======== *@
<section class="section">
    <div class="shell">
        <div class="cta-ticket reveal">

            <div class="cta-ticket-body">
                <span class="eyebrow">Admit one organization</span>
                <h2>Your next general assembly can check in 400 people.</h2>
                <p>
                    Set up your org, publish one event, and see the difference at the door.
                    Free for student organizations.
                </p>
                <div class="hero-cta">
                    <a class="btn-a lg" href="/Account/Register">Create an account</a>
                    <a class="btn-a ghost lg" href="/Account/Login">Officer sign in</a>
                </div>
            </div>

            <div class="cta-stub">
                @{
                    // Scannable, and it goes somewhere: point a phone at it and
                    // land on the sign-up page.
                    var joinUrl = Url.Action("Register", "Account", null, Context.Request.Scheme);
                    var joinQr = Apilan.Helpers.QrCode.Render(joinUrl ?? "APL-JOIN");
                    var joinSpan = joinQr.Modules + 4;
                }
                <svg class="qr" viewBox="-2 -2 @joinSpan @joinSpan" role="img"
                     aria-label="QR code to the sign-up page">
                    <path d="@joinQr.Path" />
                </svg>
                <span class="admit">APL · JOIN</span>
                <span class="fine">One org<br />Unlimited events<br />No cost</span>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/landing.js" asp-append-version="true"></script>
    <script src="~/js/calendar.js" asp-append-version="true"></script>
}
