@model Apilan.ViewModels.AuditLogViewModel
@{
    ViewData["Title"] = "Activity log";
    ViewData["Module"] = "Administration";
    Layout = "_LayoutAdmin";

}

<form class="filter-bar" method="get" asp-action="Index">
    <div class="field">
        <label for="action">Action</label>
        <select id="action" class="input-a" name="act">
            <option value="">Everything</option>
            @foreach (var a in Model.Actions)
            {
                <option value="@a" selected="@(Model.Action == a)">@a</option>
            }
        </select>
    </div>

    <div class="field">
        <label for="entityName">Record type</label>
        <select id="entityName" class="input-a" name="entityName">
            <option value="">Any</option>
            @foreach (var e in Model.Entities)
            {
                <option value="@e" selected="@(Model.EntityName == e)">@e</option>
            }
        </select>
    </div>

    <div class="field">
        <label for="actorId">Who</label>
        <select id="actorId" class="input-a" name="actorId">
            <option value="">Anyone</option>
            @foreach (var (id, name) in Model.Actors)
            {
                <option value="@id" selected="@(Model.ActorId == id)">@name</option>
            }
        </select>
    </div>

    <div class="field">
        <label for="from">From</label>
        <input id="from" class="input-a mono" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="field">
        <label for="to">To</label>
        <input id="to" class="input-a mono" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="field">
        <label>&nbsp;</label>
        <div class="row-actions">
            <button type="submit" class="btn-a sm">Filter</button>
            <a class="btn-a ghost sm" asp-action="Index">Clear</a>
        </div>
    </div>
</form>

@if (!Model.Rows.Any())
{
    <div class="empty-a">
        <h4>Nothing logged in this view</h4>
        <p>The trail fills as accounts are approved, events published, and attendance corrected.</p>
    </div>
}
else
{
    <div class="panel">
        <div class="panel-head">
            <h2>What has happened</h2>
            <span class="dim">@Model.FirstOnPage–@Model.LastOnPage of @Model.Total</span>
        </div>

        <table class="table-a">
            <thead>
                <tr>
                    <th style="width:170px">When</th>
                    <th>Who</th>
                    <th>Action</th>
                    <th>Record</th>
                    <th>Detail</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td class="mono nowrap">
                        @r.OccurredOn.ToString("d MMM yyyy")
                        <div class="dim" style="font-size:var(--fs-2xs)">@r.OccurredOn.ToString("h:mm:ss tt")</div>
                    </td>
                    <td>@(r.ActorName ?? "System")</td>
                    <td><span class="chip @r.Chip">@r.Action</span></td>
                    <td>
                        @r.EntityName
                        @if (!string.IsNullOrWhiteSpace(r.EntityId))
                        {
                            <div class="dim mono" style="font-size:var(--fs-2xs)">@r.EntityId</div>
                        }
                    </td>
                    <td class="dim" style="font-size:var(--fs-2xs)">@(r.Detail ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>

        <div class="report-note pager">
            <span class="dim">Page @Model.Page of @Model.Pages</span>
            @if (Model.HasPrevious)
            {
                <a class="btn-a ghost sm" asp-action="Index"
                   asp-route-act="@Model.Action" asp-route-entityName="@Model.EntityName"
                   asp-route-actorId="@Model.ActorId"
                   asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                   asp-route-page="@(Model.Page - 1)">Newer</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn-a ghost sm" asp-action="Index"
                   asp-route-act="@Model.Action" asp-route-entityName="@Model.EntityName"
                   asp-route-actorId="@Model.ActorId"
                   asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                   asp-route-page="@(Model.Page + 1)">Older</a>
            }
        </div>
    </div>
}
