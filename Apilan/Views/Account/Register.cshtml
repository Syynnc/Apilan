@model Apilan.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Request an account";
    Layout = "_LayoutAuth";
}

<div class="auth-card wide">

    <div class="auth-head">
        <span class="eyebrow">Account request</span>
        <h1>Join the organization</h1>
        <p>An officer checks your details against the member roster before your account is activated.</p>
    </div>

    <form asp-action="Register" method="post" novalidate>

        <div asp-validation-summary="ModelOnly" class="auth-alert"></div>

        <div class="auth-grid">
            <div class="field">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" class="input-a" autocomplete="given-name" autofocus />
                <span asp-validation-for="FirstName" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" class="input-a" autocomplete="family-name" />
                <span asp-validation-for="LastName" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="StudentNumber"></label>
                <input asp-for="StudentNumber" class="input-a mono" placeholder="2024-01234" />
                <span asp-validation-for="StudentNumber" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="input-a" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Course"></label>
                <input asp-for="Course" class="input-a" placeholder="BSCS" />
                <span asp-validation-for="Course" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="YearLevel"></label>
                <select asp-for="YearLevel" class="input-a">
                    @for (var y = 1; y <= 5; y++)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
                <span asp-validation-for="YearLevel" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Section"></label>
                <input asp-for="Section" class="input-a" placeholder="A" />
                <span asp-validation-for="Section" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="ContactNumber"></label>
                <input asp-for="ContactNumber" class="input-a" placeholder="09XX XXX XXXX" />
                <span asp-validation-for="ContactNumber" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="input-a" type="password" autocomplete="new-password" />
                <span class="hint">At least 8 characters, with an uppercase letter and a number.</span>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="input-a" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
        </div>

        <div class="auth-actions">
            <button type="submit" class="btn-a lg">Submit request</button>
            <a class="btn-a ghost lg" asp-action="Login">Back to sign in</a>
        </div>
    </form>

    <div class="auth-foot">
        Already approved? <a asp-action="Login">Sign in instead</a>.
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
