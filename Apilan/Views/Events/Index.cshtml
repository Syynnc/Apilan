@model Apilan.ViewModels.EventListViewModel
@{
    ViewData["Title"] = "Events";
    ViewData["Module"] = "Transactions";
    Layout = "_LayoutAdmin";

    string Tab(EventStatus? s) => Model.Status == s ? "is-active" : "";
}

@section Actions {
    <a class="btn-a sm" asp-action="Create">New event</a>
}

<div class="toolbar">
    <div class="segmented">
        <a class="@Tab(null)" asp-action="Index"
           asp-route-organizationId="@Model.OrganizationId" asp-route-search="@Model.Search">All</a>
        <a class="@Tab(EventStatus.Draft)" asp-action="Index" asp-route-status="@EventStatus.Draft"
           asp-route-organizationId="@Model.OrganizationId" asp-route-search="@Model.Search">
            Drafts@(Model.DraftCount > 0 ? $" ({Model.DraftCount})" : "")
        </a>
        <a class="@Tab(EventStatus.Published)" asp-action="Index" asp-route-status="@EventStatus.Published"
           asp-route-organizationId="@Model.OrganizationId" asp-route-search="@Model.Search">
            Published@(Model.PublishedCount > 0 ? $" ({Model.PublishedCount})" : "")
        </a>
        <a class="@Tab(EventStatus.Completed)" asp-action="Index" asp-route-status="@EventStatus.Completed"
           asp-route-organizationId="@Model.OrganizationId" asp-route-search="@Model.Search">Completed</a>
        <a class="@Tab(EventStatus.Cancelled)" asp-action="Index" asp-route-status="@EventStatus.Cancelled"
           asp-route-organizationId="@Model.OrganizationId" asp-route-search="@Model.Search">Cancelled</a>
    </div>

    <span class="grow"></span>

    <form method="get" asp-action="Index" style="display:flex; gap:var(--s-2)">
        <input type="hidden" name="status" value="@Model.Status" />

        @if (Model.Organizations.Count > 1)
        {
            <select class="input-a sm" name="organizationId" aria-label="Filter by organization">
                <option value="">All organizations</option>
                @foreach (var org in Model.Organizations)
                {
                    <option value="@org.Id" selected="@(Model.OrganizationId == org.Id)">@org.Acronym</option>
                }
            </select>
        }

        <input class="input-a" type="search" name="search" value="@Model.Search" placeholder="Search events" />
        <button type="submit" class="btn-a ghost sm">Search</button>
    </form>
</div>

@if (!Model.Events.Any())
{
    <div class="empty-a">
        <h4>No events here</h4>
        <p>An event starts as a draft: give it a venue, a capacity, and its sessions, then publish it to open registration.</p>
        <a class="btn-a" style="margin-top:var(--s-4)" asp-action="Create">Create an event</a>
    </div>
}
else
{
    <div class="panel">
        <table class="table-a">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Org</th>
                    <th>When</th>
                    <th>Where</th>
                    <th class="num">Sessions</th>
                    <th style="width:200px">Slots</th>
                    <th>Status</th>
                    <th style="width:1%"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var e in Model.Events)
            {
                <tr>
                    <td>
                        <strong>
                            <span class="swatch" data-type="@e.ColorKey" aria-hidden="true"></span>
                            @e.Title
                        </strong>
                        <div class="dim" style="font-size:var(--fs-2xs)">
                            @e.TypeLabel · registration closes @e.RegistrationDeadline.ToString("d MMM, h:mm tt")
                        </div>
                    </td>
                    <td>
                        <a class="mono" asp-controller="Organizations" asp-action="Details"
                           asp-route-id="@e.OrganizationId">@e.OrgAcronym</a>
                    </td>
                    <td class="mono nowrap">@e.StartsAt.ToString("ddd d MMM")<div class="dim" style="font-size:var(--fs-2xs)">@e.StartsAt.ToString("h:mm tt")</div></td>
                    <td>@e.VenueName</td>
                    <td class="num mono">@e.Sessions</td>
                    <td>
                        <div class="bar-cell">
                            <div class="meter @(e.IsFull ? "full" : "")"><i style="width:@(e.FillPercent)%"></i></div>
                            <span class="pct">@e.Taken/@e.Capacity</span>
                        </div>
                        @if (e.Waitlisted > 0)
                        {
                            <div class="dim" style="font-size:var(--fs-2xs)">@e.Waitlisted waiting</div>
                        }
                    </td>
                    <td><span class="chip @e.StatusChip">@e.Status</span></td>
                    <td>
                        <div class="row-actions">
                            <a class="btn-a ghost sm" asp-action="Details" asp-route-id="@e.Id">Open</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
