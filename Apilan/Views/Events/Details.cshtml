@model Apilan.ViewModels.EventDetailsViewModel
@using Apilan.Services
@{
    var e = Model.Event;
    ViewData["Title"] = e.Title;
    ViewData["Module"] = "Transactions · Events";
    Layout = "_LayoutAdmin";

    string Tab(string? f) => Model.RosterFilter == f ? "is-active" : "";
}

@section Actions {
    <a class="btn-a ghost sm" asp-action="Index">All events</a>
    @if (e.Status != EventStatus.Cancelled && e.Status != EventStatus.Completed)
    {
        <a class="btn-a ghost sm" asp-action="Edit" asp-route-id="@e.Id">Edit</a>
    }
    @if (Model.Sessions.Any() && e.Status is EventStatus.Published or EventStatus.Ongoing)
    {
        <a class="btn-a sm" asp-controller="Attendance" asp-action="Door" asp-route-id="@e.Id">Open the door</a>
    }
}

<div class="tiles">
    <div class="tile accent">
        <span class="l">Slots taken</span>
        <span class="n">@Model.Taken<span style="font-size:var(--fs-lg); color:var(--ink-3)">/@e.Capacity</span></span>
        <span class="s">@Model.Remaining free · @Model.Waitlisted waiting</span>
    </div>
    <div class="tile">
        <span class="l">Confirmed</span>
        <span class="n">@Model.Confirmed</span>
        <span class="s">@Model.Pending pending · @Model.WalkIns walk-in@(Model.WalkIns == 1 ? "" : "s")</span>
    </div>
    <div class="tile">
        <span class="l">Sessions</span>
        <span class="n">@Model.Sessions.Count</span>
        <span class="s">@e.CertificateThresholdPercent% needed for a certificate</span>
    </div>
    <div class="tile">
        <span class="l">Status</span>
        <span class="n" style="font-size:var(--fs-lg)">@e.Status</span>
        <span class="s">@(Model.IsOpen ? $"Registration closes {e.RegistrationDeadline:d MMM, h:mm tt}" : "Registration is closed")</span>
    </div>
</div>

<div class="split">
    <div style="display:grid; gap:var(--s-5)">

        <div class="panel">
            <div class="panel-head">
                <h2>Roster</h2>
                <span class="dim">@Model.Roster.Count shown</span>
            </div>

            <div class="panel-body" style="padding-bottom:0">
                <div class="toolbar" style="border:0; padding:0; background:none">
                    <div class="segmented">
                        <a class="@Tab(null)" asp-action="Details" asp-route-id="@e.Id">All</a>
                        <a class="@Tab("Confirmed")" asp-action="Details" asp-route-id="@e.Id" asp-route-rosterFilter="Confirmed">Confirmed (@Model.Confirmed)</a>
                        @if (Model.Pending > 0)
                        {
                            <a class="@Tab("Pending")" asp-action="Details" asp-route-id="@e.Id" asp-route-rosterFilter="Pending">Pending (@Model.Pending)</a>
                        }
                        @if (Model.Waitlisted > 0)
                        {
                            <a class="@Tab("Waitlisted")" asp-action="Details" asp-route-id="@e.Id" asp-route-rosterFilter="Waitlisted">Waitlist (@Model.Waitlisted)</a>
                        }
                        <a class="@Tab("Cancelled")" asp-action="Details" asp-route-id="@e.Id" asp-route-rosterFilter="Cancelled">Cancelled (@Model.Cancelled)</a>
                    </div>

                    <span class="grow"></span>

                    <form method="get" asp-action="Details" style="display:flex; gap:var(--s-2)">
                        <input type="hidden" name="id" value="@e.Id" />
                        <input type="hidden" name="rosterFilter" value="@Model.RosterFilter" />
                        <input class="input-a" type="search" name="search" value="@Model.Search" placeholder="Name, number, or code" />
                        <button type="submit" class="btn-a ghost sm">Find</button>
                    </form>
                </div>
            </div>

            @if (!Model.Roster.Any())
            {
                <div class="panel-body">
                    <p class="muted">Nobody matches this view yet.</p>
                </div>
            }
            else
            {
                <table class="table-a">
                    <thead>
                        <tr>
                            <th>Participant</th>
                            <th>Code</th>
                            <th>Registered</th>
                            <th class="num">Attendance</th>
                            <th>Status</th>
                            <th>Feedback</th>
                            <th style="width:1%"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.Roster)
                    {
                        <tr>
                            <td>
                                <strong>@r.ListName</strong>
                                <div class="dim" style="font-size:var(--fs-2xs)">
                                    @r.StudentNumber · @r.CourseYear
                                    @if (r.IsWalkIn)
                                    {
                                        <text> · walk-in</text>
                                    }
                                </div>
                            </td>
                            <td><span class="code-tag">@r.Code</span></td>
                            <td class="mono nowrap">@r.RegisteredOn.ToString("d MMM")</td>
                            <td class="num mono">
                                @r.Attended / @r.Sessions
                                @if (r.Late > 0 || r.Absent > 0)
                                {
                                    <div class="dim" style="font-size:var(--fs-2xs)">
                                        @if (r.Late > 0)
                                        {
                                            <text>@r.Late late</text>
                                        }
                                        @if (r.Late > 0 && r.Absent > 0)
                                        {
                                            <text> · </text>
                                        }
                                        @if (r.Absent > 0)
                                        {
                                            <text>@r.Absent absent</text>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="chip @r.StatusChip">@r.Status</span>
                                @if (r.Status == RegistrationStatus.Waitlisted && r.WaitlistPosition.HasValue)
                                {
                                    <div class="dim" style="font-size:var(--fs-2xs)">Number @r.WaitlistPosition in the queue</div>
                                }
                            </td>
                            <td>
                                @if (r.HasFeedback)
                                {
                                    <span class="chip ok" title="Left feedback">Given</span>
                                }
                                else if (r.Attended > 0 && e.CollectsFeedback && e.EndsAt <= DateTime.Now)
                                {
                                    <span class="chip idle" title="Attended but has not responded">Awaited</span>
                                }
                                else
                                {
                                    <span class="dim">—</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions">
                                    @if (r.Status == RegistrationStatus.Pending)
                                    {
                                        <form asp-action="ApproveRegistration" asp-route-id="@e.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="registrationId" value="@r.RegistrationId" />
                                            <button type="submit" class="btn-a sm">Approve</button>
                                        </form>
                                    }
                                    @if (r.Status == RegistrationStatus.Waitlisted)
                                    {
                                        <form asp-action="PromoteRegistration" asp-route-id="@e.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="registrationId" value="@r.RegistrationId" />
                                            <button type="submit" class="btn-a sm">Promote</button>
                                        </form>
                                    }
                                    @if (r.Status != RegistrationStatus.Cancelled)
                                    {
                                        <form asp-action="CancelRegistration" asp-route-id="@e.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="registrationId" value="@r.RegistrationId" />
                                            <button type="submit" class="btn-a quiet sm">Cancel</button>
                                        </form>
                                    }
                                    <a class="btn-a ghost sm" asp-controller="Members" asp-action="Details" asp-route-id="@r.MemberId">Member</a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>

        <div class="panel">
            <div class="panel-head">
                <h2>Sessions</h2>
                <span class="dim">Attendance is taken against each one</span>
            </div>
            @if (!Model.Sessions.Any())
            {
                <div class="panel-body">
                    <p class="muted">No sessions yet — this event cannot take attendance or be published.</p>
                    <a class="btn-a sm" style="margin-top:var(--s-3)" asp-action="Edit" asp-route-id="@e.Id">Add sessions</a>
                </div>
            }
            else
            {
                foreach (var s in Model.Sessions)
                {
                    <div class="session-row">
                        <span class="seq">@s.Sequence</span>
                        <span>
                            <span class="nm">@s.Name @if (s.IsNow) { <span class="chip info">now</span> }</span>
                            <span class="tm">@s.TimeRange</span>
                        </span>
                        <span class="row-actions">
                            <span class="mono dim">
                                @s.Present present
                                @if (s.Late > 0)
                                {
                                    <text> · @s.Late late</text>
                                }
                                @if (s.Absent > 0)
                                {
                                    <text> · @s.Absent absent</text>
                                }
                                @if (s.StillIn > 0)
                                {
                                    <text> · @s.StillIn still in</text>
                                }
                            </span>
                            <a class="btn-a ghost sm" asp-controller="Attendance" asp-action="Door"
                               asp-route-id="@e.Id" asp-route-sessionId="@s.Id">Door</a>
                        </span>
                    </div>
                }
            }
        </div>
    </div>

    <div class="rail">
        <div class="panel">
            <div class="panel-head"><h3>The event</h3></div>
            <div class="panel-body">
                <dl class="detail-list" style="grid-template-columns:1fr">
                    <div><dt>Organization</dt><dd>
                        <a asp-controller="Organizations" asp-action="Details" asp-route-id="@e.OrganizationId">
                            @e.Organization?.Acronym
                        </a>
                        <div class="dim" style="font-size:var(--fs-2xs)">@e.Organization?.Name</div>
                    </dd></div>
                    <div><dt>Type</dt><dd><span class="swatch" data-type="@e.EventType?.ColorKey"></span>@e.EventType?.Name</dd></div>
                    <div><dt>Venue</dt><dd>@e.Venue?.Name<div class="dim" style="font-size:var(--fs-2xs)">@e.Venue?.Location</div></dd></div>
                    <div><dt>Runs</dt><dd>@e.StartsAt.ToString("ddd d MMM, h:mm tt") – @e.EndsAt.ToString("h:mm tt")</dd></div>
                    <div><dt>Registration closes</dt><dd>@e.RegistrationDeadline.ToString("ddd d MMM, h:mm tt")</dd></div>
                    <div><dt>Rules</dt><dd>
                        @(e.RequiresApproval ? "Approval required" : "Open registration")@(e.AllowWaitlist ? " · waitlist on" : " · no waitlist")
                    </dd></div>
                    <div><dt>Certificates</dt><dd>@(e.IssuesCertificate ? $"At {e.CertificateThresholdPercent}% attendance" : "Not issued")</dd></div>
                    <div><dt>Feedback</dt><dd>
                        @if (!e.CollectsFeedback)
                        {
                            <text>Not collected</text>
                        }
                        else if (Model.FeedbackResponses > 0)
                        {
                            <a asp-controller="Feedback" asp-action="Event" asp-route-id="@e.Id">
                                @Model.FeedbackResponses response@(Model.FeedbackResponses == 1 ? "" : "s")
                            </a>
                            <div class="dim" style="font-size:var(--fs-2xs)">
                                @(Model.FeedbackAverage.HasValue
                                    ? $"{Model.FeedbackAverage.Value:0.00} of 5"
                                    : "No scores yet")
                            </div>
                        }
                        else
                        {
                            <text>Collected, nothing in yet</text>
                        }
                    </dd></div>
                    <div><dt>Created by</dt><dd>@(e.CreatedBy?.FullName ?? "—")<div class="dim" style="font-size:var(--fs-2xs)">@e.CreatedOn.ToString("d MMM yyyy, h:mm tt")</div></dd></div>
                    <div><dt>Last edited by</dt><dd>
                        @if (e.LastEditedOn.HasValue)
                        {
                            <text>@(e.LastEditedBy?.FullName ?? "—")</text>
                            <div class="dim" style="font-size:var(--fs-2xs)">@e.LastEditedOn.Value.ToString("d MMM yyyy, h:mm tt")</div>
                        }
                        else
                        {
                            <text>Never edited</text>
                        }
                    </dd></div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(e.Description))
                {
                    <p class="muted" style="margin-top:var(--s-4); font-size:var(--fs-sm)">@e.Description</p>
                }

            </div>
        </div>

        <div class="panel">
            <div class="panel-head">
                <h3>Who touched this</h3>
                @if (User.IsInRole(Roles.Admin))
                {
                    <a class="btn-a quiet sm" asp-controller="AuditLog" asp-action="Index"
                       asp-route-entityName="Event" asp-route-entityId="@e.Id">Full log</a>
                }
            </div>
            <div class="panel-body">
                @if (!Model.History.Any())
                {
                    <p class="muted" style="font-size:var(--fs-sm)">
                        Nothing logged against this event yet.
                    </p>
                }
                else
                {
                    <ol class="trail">
                        @foreach (var h in Model.History)
                        {
                            <li>
                                <span class="what">@h.Action</span>
                                <span class="who">@(h.ActorName ?? "System")</span>
                                <span class="when mono">@h.OccurredOn.ToString("d MMM yyyy, h:mm tt")</span>
                                @if (!string.IsNullOrWhiteSpace(h.Detail))
                                {
                                    <span class="why">@h.Detail</span>
                                }
                            </li>
                        }
                    </ol>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-head"><h3>Move it along</h3></div>
            <div class="panel-body" style="display:grid; gap:var(--s-3)">
                @if (Model.CanPublish)
                {
                    <form asp-action="Publish" asp-route-id="@e.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-a" style="width:100%">Publish</button>
                        <span class="hint">Puts it on the public calendar and opens registration.</span>
                    </form>
                }

                @if (Model.CanComplete)
                {
                    <form asp-action="Complete" asp-route-id="@e.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-a ghost" style="width:100%">Close out</button>
                        <span class="hint">Settles every certificate decision against the attendance on record.</span>
                    </form>
                }

                @if (Model.CanCancel)
                {
                    <form asp-action="Cancel" asp-route-id="@e.Id" method="post" style="display:grid; gap:var(--s-2)">
                        @Html.AntiForgeryToken()
                        <input class="input-a" type="text" name="reason" placeholder="Reason (shown on the stub)" />
                        <button type="submit" class="btn-a danger" style="width:100%">Cancel the event</button>
                        <span class="hint">Voids every registration, including the waitlist.</span>
                    </form>
                }

                @if (e.IssuesCertificate && e.Status != EventStatus.Draft)
                {
                    <a class="btn-a ghost" style="width:100%" asp-controller="Certificates" asp-action="Event" asp-route-id="@e.Id">Certificates</a>
                }

                @if (Model.CanDelete)
                {
                    <form asp-action="Delete" asp-route-id="@e.Id" method="post" style="display:grid; gap:var(--s-2)"
                          onsubmit="return confirm('Delete \'@e.Title\' and its @Model.Taken registration(s)? This cannot be undone.');">
                        @Html.AntiForgeryToken()
                        <label class="hint" for="confirmTitle" style="margin:0">
                            Type the event's title to delete it and its
                            @Model.Roster.Count registration(s) for good.
                        </label>
                        <input class="input-a" type="text" id="confirmTitle" name="confirmTitle"
                               placeholder="@e.Title" autocomplete="off" required />
                        <button type="submit" class="btn-a danger" style="width:100%">Delete permanently</button>
                    </form>
                }
                else
                {
                    <span class="hint">@Model.DeleteBlockedReason</span>
                }
            </div>
        </div>

        @if (e.Status is not (EventStatus.Cancelled or EventStatus.Completed))
        {
            <div class="panel">
                <div class="panel-head"><h3>Add a participant</h3></div>
                <div class="panel-body">
                    @if (!Model.AddableMembers.Any())
                    {
                        <p class="muted" style="font-size:var(--fs-sm)">Every active member is already on the roster.</p>
                    }
                    else
                    {
                        <form asp-action="AddParticipant" asp-route-id="@e.Id" method="post" style="display:grid; gap:var(--s-3)">
                            @Html.AntiForgeryToken()
                            <div class="field" style="margin:0">
                                <label for="memberId">Member</label>
                                <select class="input-a" id="memberId" name="memberId" required>
                                    <option value="">Pick a member</option>
                                    @foreach (var m in Model.AddableMembers)
                                    {
                                        <option value="@m.Id">@m.ListName — @m.StudentNumber</option>
                                    }
                                </select>
                            </div>
                            <label class="check-row">
                                <input type="checkbox" name="walkIn" value="true" checked />
                                <span>
                                    <span class="cl">Record as a walk-in</span>
                                    <span class="cd">Skips approval and the deadline — they are at the door.</span>
                                </span>
                            </label>
                            <button type="submit" class="btn-a" style="width:100%">Add to roster</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>
