@model Apilan.ViewModels.FeedbackListViewModel
@{
    ViewData["Title"] = "Feedback";
    ViewData["Module"] = "Reports";
    Layout = "_LayoutAdmin";
}

<form method="get" asp-action="Index" class="toolbar">
    <span class="count">
        @Model.Events.Count event@(Model.Events.Count == 1 ? "" : "s") ·
        @Model.TotalResponses response@(Model.TotalResponses == 1 ? "" : "s")
    </span>

    <span class="grow"></span>

    <select class="input-a sm" name="organizationId" onchange="this.form.submit()"
            aria-label="Filter by organization">
        <option value="">All organizations</option>
        @foreach (var o in Model.Organizations)
        {
            <option value="@o.Id" selected="@(Model.OrganizationId == o.Id)">@o.Acronym — @o.Name</option>
        }
    </select>

    <button type="submit" class="btn-a ghost sm">Filter</button>
</form>

@if (!Model.Events.Any())
{
    <div class="empty-a">
        <h4>No feedback yet</h4>
        <p>
            Feedback opens to participants once an event is over, and only for people with
            attendance on record. Close out an event and the responses land here.
        </p>
        <a class="btn-a" style="margin-top:var(--s-4)" asp-controller="Events" asp-action="Index">Open events</a>
    </div>
}
else
{
    <div class="tiles">
        <div class="tile accent">
            <span class="l">Average rating</span>
            @if (Model.AverageRating.HasValue)
            {
                <span class="n">@Model.AverageRating.Value.ToString("0.00")<small>/5</small></span>
                <span class="s">Across every response</span>
            }
            else
            {
                <span class="n dim">—</span>
            }
        </div>
        <div class="tile">
            <span class="l">Responses</span>
            <span class="n">@Model.TotalResponses</span>
            <span class="s">@Model.Events.Count event@(Model.Events.Count == 1 ? "" : "s")</span>
        </div>
    </div>

    <div class="panel">
        <table class="table-a">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Org</th>
                    <th>When</th>
                    <th class="num">Rating</th>
                    <th style="width:180px">Response rate</th>
                    <th class="num">Recommend</th>
                    <th style="width:1%"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var e in Model.Events)
            {
                <tr>
                    <td>
                        <strong>
                            <span class="swatch" data-type="@e.ColorKey" aria-hidden="true"></span>
                            @e.Title
                        </strong>
                        <div class="dim" style="font-size:var(--fs-2xs)">@e.TypeLabel</div>
                    </td>
                    <td class="mono">@e.OrgAcronym</td>
                    <td class="mono nowrap">@e.StartsAt.ToString("d MMM yyyy")</td>
                    <td class="num mono">
                        @if (e.AverageRating.HasValue)
                        {
                            <strong>@e.AverageRating.Value.ToString("0.00")</strong>
                        }
                        else
                        {
                            <span class="dim">—</span>
                        }
                    </td>
                    <td>
                        <div class="bar-cell">
                            <div class="meter"><i style="width:@(e.ResponseRatePercent)%"></i></div>
                            <span class="pct">@e.Responses/@e.Attended</span>
                        </div>
                    </td>
                    <td class="num mono">
                        @if (e.Responses > 0)
                        {
                            @($"{(int)Math.Round(e.RecommendCount * 100.0 / e.Responses)}%")
                        }
                        else
                        {
                            <span class="dim">—</span>
                        }
                    </td>
                    <td>
                        <div class="row-actions">
                            <a class="btn-a ghost sm" asp-action="Event" asp-route-id="@e.EventId">Read</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <p class="dim" style="margin-top:var(--s-4); font-size:var(--fs-2xs)">
        Response rate is out of the people who actually attended, not the people who registered —
        somebody who never came has nothing to report.
    </p>
}
