@model Apilan.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Module"] = "Transactions";
    Layout = "_LayoutAdmin";
}

@section Actions {
    <a class="btn-a sm" asp-controller="Events" asp-action="Create">New event</a>
}

<div class="tiles">
    <div class="tile accent">
        <span class="l">Published events</span>
        <span class="n">@Model.PublishedEvents</span>
        <span class="s">
            @if (Model.DraftEvents > 0)
            {
                <a asp-controller="Events" asp-action="Index" asp-route-status="@EventStatus.Draft">@Model.DraftEvents draft@(Model.DraftEvents == 1 ? "" : "s") waiting</a>
            }
            else
            {
                <text>No drafts waiting</text>
            }
        </span>
    </div>
    <div class="tile">
        <span class="l">Pending accounts</span>
        <span class="n">@Model.PendingAccounts</span>
        <span class="s">
            @if (Model.PendingAccounts > 0)
            {
                <a asp-controller="AccountRequests" asp-action="Index">Review the queue</a>
            }
            else
            {
                <text>Queue is clear</text>
            }
        </span>
    </div>
    <div class="tile">
        <span class="l">Registrations to approve</span>
        <span class="n">@Model.PendingRegistrations</span>
        <span class="s">@Model.WaitlistedTotal on waitlists</span>
    </div>
    <div class="tile">
        <span class="l">Active members</span>
        <span class="n">@Model.ActiveMembers</span>
        <span class="s">@Model.CertificatesEarned certificate@(Model.CertificatesEarned == 1 ? "" : "s") earned</span>
    </div>
</div>

@if (!Model.HasAnythingToDo)
{
    <div class="empty-a">
        <h4>Nothing needs you right now</h4>
        <p>No doors to open, no queues to clear. When an event is on, it appears here with its check-in link.</p>
        <a class="btn-a" style="margin-top:var(--s-4)" asp-controller="Events" asp-action="Create">Plan the next one</a>
    </div>
}

@if (Model.Today.Any())
{
    <div class="panel">
        <div class="panel-head">
            <h2>On today</h2>
            <span class="dim">Open the door from here</span>
        </div>
        <table class="table-a">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>When</th>
                    <th>Where</th>
                    <th style="width:200px">Turnout so far</th>
                    <th style="width:1%"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var e in Model.Today)
            {
                var pct = e.Taken <= 0 ? 0 : (int)Math.Round(e.Present * 100.0 / e.Taken);
                <tr>
                    <td>
                        <strong><span class="swatch" data-type="@e.ColorKey"></span>@e.Title</strong>
                        @if (e.IsRunningNow)
                        {
                            <span class="chip info">now</span>
                        }
                    </td>
                    <td class="mono nowrap">@e.StartsAt.ToString("h:mm tt") – @e.EndsAt.ToString("h:mm tt")</td>
                    <td>@e.VenueName</td>
                    <td>
                        <div class="bar-cell">
                            <div class="meter"><i style="width:@pct%"></i></div>
                            <span class="pct">@e.Present/@e.Taken</span>
                        </div>
                    </td>
                    <td>
                        <div class="row-actions">
                            <a class="btn-a sm" asp-controller="Attendance" asp-action="Door" asp-route-id="@e.EventId">Door</a>
                            <a class="btn-a ghost sm" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">Open</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (Model.AwaitingCloseOut.Any())
{
    <div class="panel">
        <div class="panel-head">
            <h2>Finished, not closed out</h2>
            <span class="dim">Closing out settles the certificates</span>
        </div>
        <table class="table-a">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Ended</th>
                    <th class="num">Attended</th>
                    <th style="width:1%"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var e in Model.AwaitingCloseOut)
            {
                <tr>
                    <td><strong><span class="swatch" data-type="@e.ColorKey"></span>@e.Title</strong></td>
                    <td class="mono nowrap">@e.EndsAt.ToString("d MMM, h:mm tt")</td>
                    <td class="num mono">@e.Present / @e.Taken</td>
                    <td>
                        <div class="row-actions">
                            <form asp-controller="Events" asp-action="Complete" asp-route-id="@e.EventId" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-a sm">Close out</button>
                            </form>
                            <a class="btn-a ghost sm" asp-controller="Reports" asp-action="Event" asp-route-id="@e.EventId">Report</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<div class="split">
    <div class="panel">
        <div class="panel-head">
            <h2>Coming up</h2>
            <a class="btn-a ghost sm" asp-controller="Events" asp-action="Index">All events</a>
        </div>

        @if (!Model.Upcoming.Any())
        {
            <div class="panel-body">
                <p class="muted">Nothing is scheduled after today.</p>
            </div>
        }
        else
        {
            <table class="table-a">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>When</th>
                        <th style="width:200px">Slots</th>
                        <th style="width:1%"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var e in Model.Upcoming)
                {
                    <tr>
                        <td>
                            <strong><span class="swatch" data-type="@e.ColorKey"></span>@e.Title</strong>
                            <div class="dim" style="font-size:var(--fs-2xs)">@e.VenueName · @e.Sessions session@(e.Sessions == 1 ? "" : "s")</div>
                        </td>
                        <td class="mono nowrap">@e.StartsAt.ToString("ddd d MMM")</td>
                        <td>
                            <div class="bar-cell">
                                <div class="meter"><i style="width:@(e.FillPercent)%"></i></div>
                                <span class="pct">@e.Taken/@e.Capacity</span>
                            </div>
                        </td>
                        <td><a class="btn-a ghost sm" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">Open</a></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    <div class="rail">
        <div class="panel">
            <div class="panel-head">
                <h3>Lately</h3>
                <a class="btn-a ghost sm" asp-controller="AuditLog" asp-action="Index">Full log</a>
            </div>
            <div class="panel-body">
                @if (!Model.Recent.Any())
                {
                    <p class="muted" style="font-size:var(--fs-sm)">Nothing has happened yet.</p>
                }
                else
                {
                    <ul style="list-style:none; margin:0; padding:0; display:grid; gap:var(--s-3)">
                        @foreach (var a in Model.Recent)
                        {
                            <li>
                                <span class="chip @a.Chip">@a.Action</span>
                                <div class="dim" style="font-size:var(--fs-2xs); margin-top:2px">
                                    @(a.ActorName ?? "System") · @a.OccurredOn.ToString("d MMM, h:mm tt")
                                </div>
                                @if (!string.IsNullOrWhiteSpace(a.Detail))
                                {
                                    <div style="font-size:var(--fs-2xs)">@a.Detail</div>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
