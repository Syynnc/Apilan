@model Apilan.ViewModels.AccountRequestListViewModel
@using Apilan.Models
@{
    ViewData["Title"] = "Account requests";
    ViewData["Module"] = "Administration";
    Layout = "_LayoutAdmin";

    string Tab(AccountStatus s) => Model.Filter == s ? "is-active" : "";
}

<div class="toolbar">
    <div class="segmented">
        <a class="@Tab(AccountStatus.Pending)" asp-action="Index" asp-route-status="@AccountStatus.Pending">
            Pending@(Model.PendingCount > 0 ? $" ({Model.PendingCount})" : "")
        </a>
        <a class="@Tab(AccountStatus.Active)" asp-action="Index" asp-route-status="@AccountStatus.Active">Approved</a>
        <a class="@Tab(AccountStatus.Rejected)" asp-action="Index" asp-route-status="@AccountStatus.Rejected">Rejected</a>
        <a class="@Tab(AccountStatus.Disabled)" asp-action="Index" asp-route-status="@AccountStatus.Disabled">Disabled</a>
    </div>

    <span class="count">@Model.Requests.Count record@(Model.Requests.Count == 1 ? "" : "s")</span>
</div>

@if (!Model.Requests.Any())
{
    <div class="empty-a">
        <h4>Nothing in this queue</h4>
        @if (Model.Filter == AccountStatus.Pending)
        {
            <p>Every account request has been reviewed. New requests appear here as students submit them.</p>
        }
        else
        {
            <p>No accounts currently have this status.</p>
        }
    </div>
}
else
{
    <div class="panel">
        <table class="table-a">
            <thead>
                <tr>
                    <th>Applicant</th>
                    <th>Student no.</th>
                    <th>Course &amp; year</th>
                    <th>Contact</th>
                    <th>Requested</th>
                    @if (Model.Filter == AccountStatus.Pending)
                    {
                        <th style="width:280px">Decision</th>
                    }
                    else
                    {
                        <th>Status</th>
                        <th>Reviewed</th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Requests)
            {
                <tr>
                    <td>
                        <strong>@r.FullName</strong>
                        <div class="dim" style="font-size:var(--fs-2xs)">@r.Email</div>
                    </td>
                    <td class="mono">@(r.StudentNumber ?? "—")</td>
                    <td>@r.CourseYear@(string.IsNullOrWhiteSpace(r.Section) ? "" : $" · {r.Section}")</td>
                    <td class="mono">@(string.IsNullOrWhiteSpace(r.ContactNumber) ? "—" : r.ContactNumber)</td>
                    <td class="mono nowrap">@r.RequestedOn.ToString("dd MMM yyyy")</td>

                    @if (Model.Filter == AccountStatus.Pending)
                    {
                        <td>
                            <div class="row-actions">
                                <form asp-action="Approve" asp-route-id="@r.UserId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-a sm">Approve</button>
                                </form>

                                <form asp-action="Reject" asp-route-id="@r.UserId" method="post"
                                      style="display:flex; gap:var(--s-2); align-items:center">
                                    @Html.AntiForgeryToken()
                                    <input type="text" name="note" class="reject-note" placeholder="Reason (optional)" />
                                    <button type="submit" class="btn-a ghost sm">Reject</button>
                                </form>
                            </div>
                        </td>
                    }
                    else
                    {
                        <td><span class="chip @r.StatusChip">@r.Status</span></td>
                        <td>
                            @if (r.ReviewedOn.HasValue)
                            {
                                <span class="mono nowrap">@r.ReviewedOn.Value.ToString("dd MMM yyyy")</span>
                                <div class="dim" style="font-size:var(--fs-2xs)">
                                    @(r.ReviewedByName ?? "—")
                                    @if (!string.IsNullOrWhiteSpace(r.ReviewNote))
                                    {
                                        <text> · @r.ReviewNote</text>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="dim">—</span>
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}
