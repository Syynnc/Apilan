@using Apilan.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject Apilan.Data.ApilanDbContext Db
@inject Apilan.Services.OrgContext Orgs
@using Microsoft.EntityFrameworkCore
@*
    Console shell — officers and admins.
    Sidebar grouped the way the HLD groups the modules: Transactions,
    Master Data, Reports, Administration.
*@
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var roleLabel = "Officer";
    var pendingAccounts = await Db.Users.CountAsync(u => u.Status == AccountStatus.Pending);

    // An admin is campus-wide and may belong to no single org; a one-org
    // install resolves to that org for everybody.
    var currentOrg = await Orgs.CurrentAsync(User);

    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    Func<string, string> nav = name =>
        controller.Equals(name, StringComparison.OrdinalIgnoreCase) ? "side-link is-active" : "side-link";

    var initials = string.Concat((currentUser?.FullName ?? "?")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(w => char.ToUpperInvariant(w[0])));
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Apilan</title>
    <meta name="theme-color" content="#F7F5EF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101210" media="(prefers-color-scheme: dark)" />

    <script>
        (function () {
            try {
                var s = localStorage.getItem("apilan-theme");
                var t = s || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
                document.documentElement.setAttribute("data-theme", t);

                if (localStorage.getItem("apilan-side") === "collapsed") {
                    document.documentElement.setAttribute("data-side", "collapsed");
                }
            } catch (e) { }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Fraunces:ital,opsz,wght@0,9..144,600;1,9..144,600&display=swap" />

    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/screens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="console">

    <aside class="side" id="side-nav">
        <div class="side-head">
            <a class="brand" asp-controller="Dashboard" asp-action="Index" title="Apilan">
                <svg class="tally" viewBox="0 0 26 24" aria-hidden="true">
                    <line x1="4"  y1="5" x2="4"  y2="19" />
                    <line x1="9"  y1="5" x2="9"  y2="19" />
                    <line x1="14" y1="5" x2="14" y2="19" />
                    <line x1="19" y1="5" x2="19" y2="19" />
                    <line class="slash" x1="1.5" y1="18.5" x2="21.5" y2="5.5" />
                </svg>
                <span class="lbl">Apilan</span>
            </a>

            <button type="button" class="side-toggle" data-side-toggle
                    aria-controls="side-nav" aria-expanded="true">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="16" rx="2" />
                    <path d="M9 4v16" />
                    <path class="caret" d="M15.5 9.5 13 12l2.5 2.5" />
                </svg>
                <span class="visually-hidden">Collapse the sidebar</span>
            </button>
        </div>

        <div class="side-org">
            @if (currentOrg is not null)
            {
                <a asp-controller="Organizations" asp-action="Details" asp-route-id="@currentOrg.Id"
                   title="@currentOrg.Name">@currentOrg.Acronym</a>
            }
            else
            {
                <a asp-controller="Organizations" asp-action="Index">All organizations</a>
            }
        </div>

        <nav class="side-group">
            <h6>Transactions</h6>
            <a class="@nav("Dashboard")" title="Dashboard" asp-controller="Dashboard" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="8" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="11" width="7" height="10" rx="1.5"/></svg>
                <span class="lbl">Dashboard</span>
            </a>
            <a class="@nav("Events")" title="Events" asp-controller="Events" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
                <span class="lbl">Events</span>
            </a>
            <a class="@nav("Attendance")" title="Check-in" asp-controller="Attendance" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5"/></svg>
                <span class="lbl">Check-in</span>
            </a>
            <a class="@nav("Certificates")" title="Certificates" asp-controller="Certificates" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v11a6 6 0 0 1-12 0z"/><path d="M9 20h6M12 20v-3"/></svg>
                <span class="lbl">Certificates</span>
            </a>
        </nav>

        <nav class="side-group">
            <h6>Master data</h6>
            <a class="@nav("Organizations")" title="Organizations" asp-controller="Organizations" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V8l6-4 6 4v13"/><path d="M4 21h16M10 21v-5h4v5M8 11h.01M12 11h.01M8 14h.01M12 14h.01"/></svg>
                <span class="lbl">Organizations</span>
            </a>
            <a class="@nav("Members")" title="Members" asp-controller="Members" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19c1.2-3 3.2-4.5 5.5-4.5S13.3 16 14.5 19M17 8h4M17 12h4"/></svg>
                <span class="lbl">Members</span>
            </a>
            <a class="@nav("EventTypes")" title="Event types" asp-controller="EventTypes" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
                <span class="lbl">Event types</span>
            </a>
            <a class="@nav("Venues")" title="Venues" asp-controller="Venues" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                <span class="lbl">Venues</span>
            </a>
        </nav>

        <nav class="side-group">
            <h6>Reports</h6>
            <a class="@nav("Reports")" title="Participation" asp-controller="Reports" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V4M4 20h16M8 20v-6M13 20v-10M18 20v-4"/></svg>
                <span class="lbl">Participation</span>
            </a>
            <a class="@nav("Feedback")" title="Feedback" asp-controller="Feedback" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/><path d="M8 10h8M8 13h5"/></svg>
                <span class="lbl">Feedback</span>
            </a>
        </nav>

        <nav class="side-group">
            <h6>Administration</h6>
            <a class="@nav("AccountRequests")" title="Account requests" asp-controller="AccountRequests" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="8" r="3.2"/><path d="M4 19c1.3-3 3.4-4.5 6-4.5M17 13v6M14 16h6"/></svg>
                <span class="lbl">Account requests</span>
                @if (pendingAccounts > 0)
                {
                    <span class="count">@pendingAccounts</span>
                }
            </a>
            <a class="@nav("Officers")" title="Officers & roles" asp-controller="Officers" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.2-2.9 7.7-7 9-4.1-1.3-7-4.8-7-9V6z"/><path d="M9.5 12l1.8 1.8 3.5-3.6"/></svg>
                <span class="lbl">Officers &amp; roles</span>
            </a>
            <a class="@nav("AuditLog")" title="Activity log" asp-controller="AuditLog" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
                <span class="lbl">Activity log</span>
            </a>
        </nav>

        <div class="side-foot">
            <div class="side-user">
                <span class="av" aria-hidden="true">@initials</span>
                <span class="who">
                    <span class="nm">@(currentUser?.FullName ?? "Signed in")</span>
                    <span class="rl">@roleLabel</span>
                </span>
            </div>

            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-a ghost sm side-out" title="Sign out">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4" />
                        <path d="M10 8l-4 4 4 4M6 12h10" />
                    </svg>
                    <span class="lbl">Sign out</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="console-main">
        <header class="console-bar">
            <div class="titles">
                <div class="crumb">@ViewData["Module"]</div>
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="actions">
                @await RenderSectionAsync("Actions", required: false)
                <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Switch theme">
                    <svg class="tt-icon tt-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                    </svg>
                    <svg class="tt-icon tt-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </svg>
                    <span class="tt-label"></span>
                </button>
            </div>
        </header>

        <main class="console-body">
            @if (TempData["Success"] is string ok)
            {
                <div class="flash ok"><strong>Done.</strong> @ok</div>
            }
            @if (TempData["Error"] is string bad)
            {
                <div class="flash bad"><strong>Not done.</strong> @bad</div>
            }

            @RenderBody()
        </main>
    </div>

</div>

<script src="~/js/theme.js" asp-append-version="true"></script>
<script src="~/js/console.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
