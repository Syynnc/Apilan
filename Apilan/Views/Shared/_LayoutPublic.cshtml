@using Apilan.Models
@*
    Public shell — landing, event directory, event detail, auth, member area.
    The admin console and the door kiosk get their own shells.
*@
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Apilan</title>
    <meta name="description" content="Apilan is an event registration and attendance system for student organizations. Publish events, take registrations, check people in, and issue certificates." />
    <meta name="theme-color" content="#F7F5EF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101210" media="(prefers-color-scheme: dark)" />

    @* Resolve the theme before first paint so there is no white flash on dark. *@
    <script>
        (function () {
            try {
                var s = localStorage.getItem("apilan-theme");
                var t = s || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
                document.documentElement.setAttribute("data-theme", t);
            } catch (e) { }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Fraunces:ital,opsz,wght@0,9..144,600;1,9..144,600&display=swap" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/screens.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="landing">

    @await Html.PartialAsync("_CalendarBackdrop")

    <header class="site-nav">
        <div class="shell inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                @* Tally mark — four strokes and a slash, how attendance has always been counted. *@
                <svg class="tally" viewBox="0 0 26 24" aria-hidden="true">
                    <line x1="4"  y1="5" x2="4"  y2="19" />
                    <line x1="9"  y1="5" x2="9"  y2="19" />
                    <line x1="14" y1="5" x2="14" y2="19" />
                    <line x1="19" y1="5" x2="19" y2="19" />
                    <line class="slash" x1="1.5" y1="18.5" x2="21.5" y2="5.5" />
                </svg>
                Apilan
            </a>

            <ul class="nav-links">
                <li><a asp-controller="Calendar" asp-action="Index">Calendar</a></li>
                <li><a href="/#how">How it works</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li><a asp-controller="MyEvents" asp-action="Index">My events</a></li>
                }
                else
                {
                    <li><a href="/#checkin">Check-in</a></li>
                    <li><a href="/#reports">Reports</a></li>
                }
            </ul>

            <div class="nav-actions">
                <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Switch to dark theme">
                    <svg class="tt-icon tt-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                    </svg>
                    <svg class="tt-icon tt-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </svg>
                    <span class="tt-label"></span>
                </button>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Officer))
                    {
                        <a class="btn-a ghost" asp-controller="Dashboard" asp-action="Index">Console</a>
                    }
                    <a class="btn-a" asp-controller="MyEvents" asp-action="Index">My events</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-a quiet">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="btn-a ghost" href="/Account/Login">Log in</a>
                    <a class="btn-a" href="/Account/Register">Create account</a>
                }
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-foot">
        <div class="shell">

            <div class="foot-grid">
                <div class="foot-brand">
                    <a class="brand" asp-controller="Home" asp-action="Index">
                        <svg class="tally" viewBox="0 0 26 24" aria-hidden="true">
                            <line x1="4"  y1="5" x2="4"  y2="19" />
                            <line x1="9"  y1="5" x2="9"  y2="19" />
                            <line x1="14" y1="5" x2="14" y2="19" />
                            <line x1="19" y1="5" x2="19" y2="19" />
                            <line class="slash" x1="1.5" y1="18.5" x2="21.5" y2="5.5" />
                        </svg>
                        Apilan
                    </a>
                    <p>
                        A web-based event registration and attendance system for student
                        organizations — from publishing an event to issuing certificates
                        and closing out the post-activity report.
                    </p>
                </div>

                <div class="foot-col">
                    <h5>System</h5>
                    <ul>
                        <li><a asp-controller="Calendar" asp-action="Index">Event calendar</a></li>
                        <li><a href="/#stubs">Registration stubs</a></li>
                        <li><a href="/#checkin">Door check-in</a></li>
                        <li><a href="/#reports">Reports &amp; certificates</a></li>
                    </ul>
                </div>

                <div class="foot-col">
                    <h5>Roles</h5>
                    <ul>
                        <li><a href="/#roles">For members</a></li>
                        <li><a href="/#roles">For officers</a></li>
                        <li><a href="/#roles">For admins</a></li>
                        <li><a href="/#how">How it works</a></li>
                    </ul>
                </div>

                <div class="foot-col">
                    <h5>Account</h5>
                    <ul>
                        <li><a href="/Account/Login">Log in</a></li>
                        <li><a href="/Account/Register">Create an account</a></li>
                        <li><a href="/Account/Login">Officer sign in</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    </ul>
                </div>
            </div>

            <div class="foot-bar">
                <span>&copy; @DateTime.Now.Year Apilan · Built for student organizations</span>
                <span class="legal">
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                    <a href="/#how">How it works</a>
                    <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Switch theme">
                        <svg class="tt-icon tt-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                        </svg>
                        <svg class="tt-icon tt-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="4" />
                            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                        </svg>
                        <span class="tt-label"></span>
                    </button>
                </span>
            </div>

        </div>
    </footer>

</div>

<script src="~/js/theme.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
