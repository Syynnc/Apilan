@model Apilan.ViewModels.CalendarViewModel
@{
    ViewData["Title"] = "What's on";
    Layout = "_LayoutPublic";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}

<section class="section">
    <div class="shell">

        <div class="section-head">
            <span class="eyebrow">Calendar</span>
            <h2>Everything that is open.</h2>
            <p>Registering gives you a stub with a check-in code. Bring the code; that is the whole process.</p>
        </div>

        @if (TempData["Success"] is string ok)
        {
            <div class="flash ok"><strong>Done.</strong> @ok</div>
        }
        @if (TempData["Error"] is string bad)
        {
            <div class="flash bad"><strong>Not done.</strong> @bad</div>
        }

        <form method="get" asp-action="Index" class="filter-bar" style="margin-bottom:var(--s-5)">
            <div class="field grow">
                <label for="search">Search</label>
                <input id="search" class="input-a" type="search" name="search" value="@Model.Search"
                       placeholder="Title or description" />
            </div>
            <div class="field">
                <label for="typeId">Type</label>
                <select id="typeId" class="input-a" name="typeId">
                    <option value="">Any type</option>
                    @foreach (var t in Model.Types)
                    {
                        <option value="@t.Id" selected="@(Model.TypeId == t.Id)">@t.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="organizationId">Organization</label>
                <select id="organizationId" class="input-a" name="organizationId">
                    <option value="">Any organization</option>
                    @foreach (var o in Model.Organizations)
                    {
                        <option value="@o.Id" selected="@(Model.OrganizationId == o.Id)">@o.Acronym</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>&nbsp;</label>
                <div class="row-actions">
                    <button type="submit" class="btn-a sm">Filter</button>
                    <a class="btn-a ghost sm" asp-action="Index">Clear</a>
                    <a class="btn-a quiet sm" asp-action="Month"
                       asp-route-typeId="@Model.TypeId"
                       asp-route-organizationId="@Model.OrganizationId">Month view</a>
                </div>
            </div>
        </form>

        @if (!Model.Events.Any())
        {
            <div class="empty-a">
                <h4>Nothing open right now</h4>
                <p>
                    Nothing upcoming has been published yet. Check back, ask an officer what is
                    being planned, or <a asp-action="Month">look through the calendar</a> for
                    what has already run.
                </p>
            </div>
        }
        else
        {
            <div class="event-grid">
                @foreach (var e in Model.Events)
                {
                    var mine = Model.MyRegistrations.TryGetValue(e.Id, out var status) ? (RegistrationStatus?)status : null;

                    <article class="card-a pop event-card" data-type="@e.ColorKey">
                        <div class="event-card-head">
                            <span class="chip idle">@e.TypeLabel</span>
                            @if (e.IssuesCertificate)
                            {
                                <span class="chip info">Certificate</span>
                            }
                        </div>

                        <h3><a asp-action="Details" asp-route-id="@e.Id">@e.Title</a></h3>

                        <dl class="event-card-meta">
                            <div><dt>When</dt><dd>@e.StartsAt.ToString("ddd d MMM") · @e.TimeRange</dd></div>
                            <div><dt>Where</dt><dd>@e.VenueName@(string.IsNullOrWhiteSpace(e.VenueLocation) ? "" : $", {e.VenueLocation}")</dd></div>
                            <div><dt>Closes</dt><dd>@e.RegistrationDeadline.ToString("ddd d MMM, h:mm tt")</dd></div>
                        </dl>

                        <div class="bar-cell" style="margin-top:var(--s-4)">
                            <div class="meter @(e.IsFull ? "full" : "")"><i style="width:@(e.FillPercent)%"></i></div>
                            <span class="pct">@e.Remaining left</span>
                        </div>

                        <div class="event-card-foot">
                            @if (mine is not null)
                            {
                                <span class="chip ok">You are @mine.ToString()!.ToLowerInvariant()</span>
                                <a class="btn-a ghost sm" asp-controller="MyEvents" asp-action="Index">Your stub</a>
                            }
                            else if (!e.IsOpen)
                            {
                                <span class="chip idle">Registration closed</span>
                            }
                            else if (e.IsFull && !e.AllowWaitlist)
                            {
                                <span class="chip warn">Full</span>
                            }
                            else if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-action="Register" asp-route-id="@e.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit" class="btn-a sm">@e.CallToAction</button>
                                </form>
                            }
                            else
                            {
                                <a class="btn-a sm" asp-controller="Account" asp-action="Login"
                                   asp-route-returnUrl="@Url.Action("Details", "Calendar", new { id = e.Id })">Sign in to register</a>
                            }

                            <a class="btn-a quiet sm" asp-action="Details" asp-route-id="@e.Id">Details</a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
