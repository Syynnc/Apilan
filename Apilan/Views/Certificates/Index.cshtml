@model List<Apilan.ViewModels.CertificateEventRow>
@{
    ViewData["Title"] = "Certificates";
    ViewData["Module"] = "Transactions";
    Layout = "_LayoutAdmin";
}

@if (!Model.Any())
{
    <div class="empty-a">
        <h4>Nothing to issue yet</h4>
        <p>Certificates follow attendance. Once an event that issues them is published, it appears here.</p>
        <a class="btn-a" style="margin-top:var(--s-4)" asp-controller="Events" asp-action="Index">Go to events</a>
    </div>
}
else
{
    <div class="panel">
        <div class="panel-head">
            <h2>By event</h2>
            <span class="dim">Eligibility is computed from attendance, never typed in</span>
        </div>
        <table class="table-a">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>When</th>
                    <th class="num">Rule</th>
                    <th class="num">Participants</th>
                    <th style="width:200px">Earned</th>
                    <th>Status</th>
                    <th style="width:1%"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>
                        <strong><span class="swatch" data-type="@r.ColorKey"></span>@r.Title</strong>
                        <div class="dim" style="font-size:var(--fs-2xs)">@r.TypeLabel · @r.Sessions session@(r.Sessions == 1 ? "" : "s")</div>
                    </td>
                    <td class="mono nowrap">@r.StartsAt.ToString("d MMM yyyy")</td>
                    <td class="num mono">@r.ThresholdPercent%</td>
                    <td class="num mono">@r.Participants</td>
                    <td>
                        <div class="bar-cell">
                            <div class="meter"><i style="width:@(r.EarnedPercent)%"></i></div>
                            <span class="pct">@r.Earned</span>
                        </div>
                    </td>
                    <td>
                        <span class="chip @(r.IsSettled ? "ok" : "warn")">@(r.IsSettled ? "Settled" : "Provisional")</span>
                    </td>
                    <td><a class="btn-a ghost sm" asp-action="Event" asp-route-id="@r.EventId">Open</a></td>
                </tr>
            }
            </tbody>
        </table>
        <div class="report-note">
            A provisional event is still running, so its numbers can still move. Closing an
            event out settles every decision against the attendance on record.
        </div>
    </div>
}
