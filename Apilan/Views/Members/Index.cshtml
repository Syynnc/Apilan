@model Apilan.ViewModels.MemberListViewModel
@{
    ViewData["Title"] = "Members";
    ViewData["Module"] = "Master data";
    Layout = "_LayoutAdmin";
}

@section Actions {
    <a class="btn-a sm" asp-action="Create">Add member</a>
}

<form class="filter-bar" method="get" asp-action="Index">
    <div class="field grow">
        <label for="search">Search</label>
        <input id="search" class="input-a" type="search" asp-for="Search"
               placeholder="Name, student number, or email" />
    </div>

    <div class="field">
        <label for="status">Status</label>
        <select id="status" class="input-a" asp-for="Status" asp-items="Html.GetEnumSelectList<MembershipStatus>()">
            <option value="">Any</option>
        </select>
    </div>

    <div class="field">
        <label for="type">Type</label>
        <select id="type" class="input-a" asp-for="Type" asp-items="Html.GetEnumSelectList<MembershipType>()">
            <option value="">Any</option>
        </select>
    </div>

    <div class="field">
        <label for="course">Course</label>
        <select id="course" class="input-a" name="course">
            <option value="">Any</option>
            @foreach (var c in Model.Courses)
            {
                <option value="@c" selected="@(c == Model.Course)">@c</option>
            }
        </select>
    </div>

    <div class="field">
        <label>&nbsp;</label>
        <div class="row-actions">
            <button type="submit" class="btn-a sm">Filter</button>
            <a class="btn-a ghost sm" asp-action="Index">Clear</a>
        </div>
    </div>
</form>

<div class="toolbar">
    <span class="count">@Model.Members.Count of @(Model.ActiveCount + Model.InactiveCount) record@(Model.Members.Count == 1 ? "" : "s")</span>
    <span class="grow"></span>
    <span class="count">@Model.ActiveCount active · @Model.InactiveCount inactive</span>
</div>

@if (!Model.Members.Any())
{
    <div class="empty-a">
        <h4>No members match</h4>
        <p>Widen the filters, or add the person to the roster if they are new.</p>
        <a class="btn-a" style="margin-top:var(--s-4)" asp-action="Create">Add member</a>
    </div>
}
else
{
    <div class="panel">
        <table class="table-a">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Student no.</th>
                    <th>Course &amp; year</th>
                    <th>Type</th>
                    <th class="num">Events</th>
                    <th>Joined</th>
                    <th>Status</th>
                    <th style="width:1%"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var m in Model.Members)
            {
                <tr>
                    <td>
                        <strong>@m.ListName</strong>
                        <div class="dim" style="font-size:var(--fs-2xs)">
                            @(m.Email ?? "No email on file")
                            @if (m.HasAccount)
                            {
                                <text> · has an account</text>
                            }
                        </div>
                    </td>
                    <td class="mono">@m.StudentNumber</td>
                    <td>@m.CourseYear@(string.IsNullOrWhiteSpace(m.Section) ? "" : $" · {m.Section}")</td>
                    <td>@m.MembershipType</td>
                    <td class="num mono">@m.Registrations</td>
                    <td class="mono nowrap">@m.JoinedOn.ToString("dd MMM yyyy")</td>
                    <td><span class="chip @m.StatusChip">@m.Status</span></td>
                    <td>
                        <div class="row-actions">
                            <a class="btn-a ghost sm" asp-action="Details" asp-route-id="@m.Id">Open</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
