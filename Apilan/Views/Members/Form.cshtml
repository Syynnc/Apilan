@model Apilan.ViewModels.MemberFormViewModel
@{
    ViewData["Title"] = Model.IsNew ? "Add member" : "Edit member";
    ViewData["Module"] = "Master data";
    Layout = "_LayoutAdmin";
}

<form method="post"
      asp-action="@(Model.IsNew ? "Create" : "Edit")"
      asp-route-id="@(Model.IsNew ? null : (int?)Model.Id)">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="panel">
        <div class="panel-head">
            <h2>Identity</h2>
            <span class="dim">What the roster is keyed on</span>
        </div>
        <div class="panel-body form-a">
            <div class="field span-2">
                <label asp-for="StudentNumber"></label>
                <input class="input-a mono" asp-for="StudentNumber" placeholder="2024-01234" />
                <span class="field-error" asp-validation-for="StudentNumber"></span>
            </div>

            <div class="field span-2">
                <label asp-for="MembershipType"></label>
                <select class="input-a" asp-for="MembershipType" asp-items="Html.GetEnumSelectList<MembershipType>()"></select>
            </div>

            <div class="field span-2">
                <label asp-for="FirstName"></label>
                <input class="input-a" asp-for="FirstName" />
                <span class="field-error" asp-validation-for="FirstName"></span>
            </div>

            <div class="field span-2">
                <label asp-for="LastName"></label>
                <input class="input-a" asp-for="LastName" />
                <span class="field-error" asp-validation-for="LastName"></span>
            </div>

            <div class="field span-2">
                <label asp-for="MiddleName"></label>
                <input class="input-a" asp-for="MiddleName" />
                <span class="field-error" asp-validation-for="MiddleName"></span>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <h2>Academic</h2>
        </div>
        <div class="panel-body form-a">
            <div class="field span-2">
                <label asp-for="Course"></label>
                <input class="input-a" asp-for="Course" placeholder="BSCS" />
                <span class="field-error" asp-validation-for="Course"></span>
            </div>

            <div class="field">
                <label asp-for="YearLevel"></label>
                <input class="input-a" asp-for="YearLevel" type="number" min="1" max="6" />
                <span class="field-error" asp-validation-for="YearLevel"></span>
            </div>

            <div class="field">
                <label asp-for="Section"></label>
                <input class="input-a" asp-for="Section" placeholder="A" />
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <h2>Contact &amp; standing</h2>
        </div>
        <div class="panel-body form-a">
            <div class="field span-2">
                <label asp-for="Email"></label>
                <input class="input-a" asp-for="Email" type="email" />
                <span class="field-error" asp-validation-for="Email"></span>
            </div>

            <div class="field span-2">
                <label asp-for="ContactNumber"></label>
                <input class="input-a mono" asp-for="ContactNumber" />
                <span class="field-error" asp-validation-for="ContactNumber"></span>
            </div>

            <div class="field span-2">
                <label asp-for="Status"></label>
                <select class="input-a" asp-for="Status" asp-items="Html.GetEnumSelectList<MembershipStatus>()"></select>
                <span class="hint">Inactive keeps the history but hides the person from event registration.</span>
            </div>

            <div class="field span-2">
                <label asp-for="JoinedOn"></label>
                <input class="input-a mono" asp-for="JoinedOn" type="date" />
            </div>
        </div>
    </div>

    <div class="form-foot">
        <a class="btn-a ghost" asp-action="Index">Cancel</a>
        <button type="submit" class="btn-a">@(Model.IsNew ? "Add member" : "Save changes")</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
