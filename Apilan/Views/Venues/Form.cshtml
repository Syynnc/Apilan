@model Apilan.ViewModels.VenueFormViewModel
@{
    ViewData["Title"] = Model.IsNew ? "Add venue" : "Edit venue";
    ViewData["Module"] = "Master data";
    Layout = "_LayoutAdmin";
}

<form method="post"
      asp-action="@(Model.IsNew ? "Create" : "Edit")"
      asp-route-id="@(Model.IsNew ? null : (int?)Model.Id)">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="panel">
        <div class="panel-head">
            <h2>The room</h2>
        </div>
        <div class="panel-body form-a">
            <div class="field span-2">
                <label asp-for="Name"></label>
                <input class="input-a" asp-for="Name" placeholder="AVR 2" />
                <span class="field-error" asp-validation-for="Name"></span>
            </div>

            <div class="field span-2">
                <label asp-for="Location"></label>
                <input class="input-a" asp-for="Location" placeholder="Main Building, 2F" />
                <span class="field-error" asp-validation-for="Location"></span>
            </div>

            <div class="field span-2">
                <label asp-for="Capacity"></label>
                <input class="input-a mono" asp-for="Capacity" type="number" min="1" />
                <span class="hint">An event booked here cannot take more people than this.</span>
                <span class="field-error" asp-validation-for="Capacity"></span>
            </div>

            <div class="field span-2">
                <label asp-for="IsActive"></label>
                <select class="input-a" asp-for="IsActive">
                    <option value="true">Bookable — offered on the event form</option>
                    <option value="false">Out of service — hidden from new events</option>
                </select>
            </div>

            <div class="field span-4">
                <label asp-for="AvailabilityNotes"></label>
                <textarea class="input-a" asp-for="AvailabilityNotes" rows="2"
                          placeholder="Weather dependent. Book two weeks ahead."></textarea>
                <span class="field-error" asp-validation-for="AvailabilityNotes"></span>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <h2>Who to ask</h2>
        </div>
        <div class="panel-body form-a">
            <div class="field span-2">
                <label asp-for="ContactPerson"></label>
                <input class="input-a" asp-for="ContactPerson" placeholder="Property Office" />
                <span class="field-error" asp-validation-for="ContactPerson"></span>
            </div>

            <div class="field span-2">
                <label asp-for="ContactNumber"></label>
                <input class="input-a mono" asp-for="ContactNumber" />
                <span class="field-error" asp-validation-for="ContactNumber"></span>
            </div>
        </div>
    </div>

    <div class="form-foot">
        <a class="btn-a ghost" asp-action="Index">Cancel</a>
        <button type="submit" class="btn-a">@(Model.IsNew ? "Add venue" : "Save changes")</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
