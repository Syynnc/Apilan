@model List<Apilan.ViewModels.VenueFormViewModel>
@{
    ViewData["Title"] = "Venues";
    ViewData["Module"] = "Master data";
    Layout = "_LayoutAdmin";
}

@section Actions {
    <a class="btn-a sm" asp-action="Create">Add venue</a>
}

<div class="toolbar">
    <span class="count">@Model.Count venue@(Model.Count == 1 ? "" : "s")</span>
    <span class="grow"></span>
    <span class="dim">Capacity here is the room's ceiling — an event may take fewer, never more.</span>
</div>

@if (!Model.Any())
{
    <div class="empty-a">
        <h4>No venues yet</h4>
        <p>An event has to be held somewhere. Add the rooms the organization can book.</p>
        <a class="btn-a" style="margin-top:var(--s-4)" asp-action="Create">Add the first venue</a>
    </div>
}
else
{
    <div class="panel">
        <table class="table-a">
            <thead>
                <tr>
                    <th>Venue</th>
                    <th>Location</th>
                    <th class="num">Capacity</th>
                    <th class="num">Upcoming</th>
                    <th>Contact</th>
                    <th>Status</th>
                    <th style="width:1%"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td>
                        <strong>@v.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(v.AvailabilityNotes))
                        {
                            <div class="dim" style="font-size:var(--fs-2xs)">@v.AvailabilityNotes</div>
                        }
                    </td>
                    <td>@(v.Location ?? "—")</td>
                    <td class="num mono">@v.Capacity</td>
                    <td class="num mono">@v.UpcomingEvents</td>
                    <td>
                        @(v.ContactPerson ?? "—")
                        @if (!string.IsNullOrWhiteSpace(v.ContactNumber))
                        {
                            <div class="dim mono" style="font-size:var(--fs-2xs)">@v.ContactNumber</div>
                        }
                    </td>
                    <td><span class="chip @(v.IsActive ? "ok" : "idle")">@(v.IsActive ? "Bookable" : "Out of service")</span></td>
                    <td>
                        <div class="row-actions">
                            <a class="btn-a ghost sm" asp-action="Edit" asp-route-id="@v.Id">Edit</a>
                            <form asp-action="Toggle" asp-route-id="@v.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-a quiet sm">@(v.IsActive ? "Close" : "Reopen")</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
