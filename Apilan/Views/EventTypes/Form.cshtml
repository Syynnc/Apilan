@model Apilan.ViewModels.EventTypeFormViewModel
@{
    ViewData["Title"] = Model.IsNew ? "Add event type" : "Edit event type";
    ViewData["Module"] = "Master data";
    Layout = "_LayoutAdmin";
}

<form method="post"
      asp-action="@(Model.IsNew ? "Create" : "Edit")"
      asp-route-id="@(Model.IsNew ? null : (int?)Model.Id)">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="panel">
        <div class="panel-head">
            <h2>Classification</h2>
            @if (!Model.IsNew)
            {
                <span class="dim">@Model.EventCount event@(Model.EventCount == 1 ? "" : "s") use this type</span>
            }
        </div>
        <div class="panel-body form-a">
            <div class="field span-2">
                <label asp-for="Name"></label>
                <input class="input-a" asp-for="Name" placeholder="Seminar" />
                <span class="field-error" asp-validation-for="Name"></span>
            </div>

            <div class="field span-2">
                <label asp-for="IsActive"></label>
                <select class="input-a" asp-for="IsActive">
                    <option value="true">In use — offered on the event form</option>
                    <option value="false">Retired — hidden from new events</option>
                </select>
            </div>

            <div class="field span-4">
                <label asp-for="Description"></label>
                <textarea class="input-a" asp-for="Description" rows="2"
                          placeholder="Talks and guest sessions."></textarea>
                <span class="field-error" asp-validation-for="Description"></span>
            </div>

            <div class="field span-4">
                <label asp-for="ColorKey"></label>
                <div class="swatch-picker">
                    @foreach (var (key, label) in Apilan.ViewModels.EventTypeFormViewModel.Colors)
                    {
                        <label class="swatch-option">
                            <input type="radio" asp-for="ColorKey" value="@key" />
                            <span class="swatch" data-type="@key" aria-hidden="true"></span>
                            <span>@label</span>
                        </label>
                    }
                </div>
                <span class="hint">Shown on the stub spine, the calendar pip, and the event card.</span>
            </div>
        </div>
    </div>

    <div class="form-foot">
        <a class="btn-a ghost" asp-action="Index">Cancel</a>
        <button type="submit" class="btn-a">@(Model.IsNew ? "Add type" : "Save changes")</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
