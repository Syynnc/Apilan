@model List<Apilan.ViewModels.EventTypeFormViewModel>
@{
    ViewData["Title"] = "Event types";
    ViewData["Module"] = "Master data";
    Layout = "_LayoutAdmin";
}

@section Actions {
    <a class="btn-a sm" asp-action="Create">Add type</a>
}

<div class="toolbar">
    <span class="count">@Model.Count type@(Model.Count == 1 ? "" : "s")</span>
    <span class="grow"></span>
    <span class="dim">The colour key drives the ticket spine and the calendar pip.</span>
</div>

@if (!Model.Any())
{
    <div class="empty-a">
        <h4>No event types yet</h4>
        <p>Every event is classified under a type — seminar, workshop, outreach, and so on.</p>
        <a class="btn-a" style="margin-top:var(--s-4)" asp-action="Create">Add the first type</a>
    </div>
}
else
{
    <div class="panel">
        <table class="table-a">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Colour</th>
                    <th class="num">Events</th>
                    <th>Status</th>
                    <th style="width:1%"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>
                        <strong>@t.Name</strong>
                        <div class="dim" style="font-size:var(--fs-2xs)">@(t.Description ?? "No description")</div>
                    </td>
                    <td>
                        <span class="swatch" data-type="@t.ColorKey" aria-hidden="true"></span>
                        <span class="mono">@t.ColorKey</span>
                    </td>
                    <td class="num mono">@t.EventCount</td>
                    <td><span class="chip @(t.IsActive ? "ok" : "idle")">@(t.IsActive ? "In use" : "Retired")</span></td>
                    <td>
                        <div class="row-actions">
                            <a class="btn-a ghost sm" asp-action="Edit" asp-route-id="@t.Id">Edit</a>
                            <form asp-action="Toggle" asp-route-id="@t.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-a quiet sm">@(t.IsActive ? "Retire" : "Restore")</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
