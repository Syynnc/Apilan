@model Apilan.ViewModels.EventReportViewModel
@using Apilan.Services
@{
    var e = Model.Event;
    ViewData["Title"] = "Report · " + e.Title;
    ViewData["Module"] = "Reports";
    Layout = "_LayoutAdmin";
}

@section Actions {
    <a class="btn-a ghost sm" asp-action="Index">Participation</a>
    <a class="btn-a ghost sm" asp-controller="Events" asp-action="Details" asp-route-id="@e.Id">Event</a>
    <a class="btn-a sm" asp-action="ExportEvent" asp-route-id="@e.Id">Export to Excel</a>
}

<div class="tiles">
    <div class="tile accent">
        <span class="l">Turnout</span>
        <span class="n">@Model.TurnoutPercent%</span>
        <span class="s">@Model.Attended of @Model.Registered registered</span>
    </div>
    <div class="tile">
        <span class="l">Average attendance</span>
        <span class="n">@Model.AverageAttendancePercent%</span>
        <span class="s">Of @Model.Sessions.Count session@(Model.Sessions.Count == 1 ? "" : "s"), over those who came</span>
    </div>
    <div class="tile">
        <span class="l">Certificates</span>
        <span class="n">@Model.Certificates</span>
        <span class="s">At the @e.CertificateThresholdPercent% rule</span>
    </div>
    <div class="tile">
        <span class="l">No-shows</span>
        <span class="n">@Model.NoShows</span>
        <span class="s">@Model.WalkIns walk-in@(Model.WalkIns == 1 ? "" : "s") · @Model.Cancelled cancelled</span>
    </div>
    <div class="tile">
        <span class="l">Late arrivals</span>
        <span class="n">@Model.LateArrivals</span>
        <span class="s">Late to at least one session</span>
    </div>
    <div class="tile">
        <span class="l">Feedback</span>
        @if (Model.FeedbackAverage.HasValue)
        {
            <span class="n">@Model.FeedbackAverage.Value.ToString("0.0")<small>/5</small></span>
            <span class="s">
                <a asp-controller="Feedback" asp-action="Event" asp-route-id="@e.Id">
                    @Model.FeedbackResponses response@(Model.FeedbackResponses == 1 ? "" : "s")
                </a>
                · @Model.FeedbackRecommendPercent% recommend
            </span>
        }
        else
        {
            <span class="n dim">—</span>
            <span class="s">@(e.CollectsFeedback ? "Nothing in yet" : "Not collected")</span>
        }
    </div>
</div>

<div class="split">
    <div style="display:grid; gap:var(--s-5)">

        <div class="panel">
            <div class="panel-head">
                <h2>Attendance</h2>
                <span class="dim">Per participant, per session</span>
            </div>

            @if (!Model.Participants.Any())
            {
                <div class="panel-body">
                    <p class="muted">Nobody held a slot for this event, so there is nothing to report.</p>
                </div>
            }
            else
            {
                <table class="table-a">
                    <thead>
                        <tr>
                            <th>Participant</th>
                            @foreach (var s in Model.Sessions)
                            {
                                <th class="num" title="@s.TimeRange">@s.Name</th>
                            }
                            <th class="num">Attended</th>
                            <th>Certificate</th>
                            <th class="num">Rating</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model.Participants)
                    {
                        <tr>
                            <td>
                                <strong>@p.ListName</strong>
                                <div class="dim" style="font-size:var(--fs-2xs)">
                                    @p.StudentNumber · @p.CourseYear@(p.IsWalkIn ? " · walk-in" : "")
                                </div>
                            </td>
                            @foreach (var s in Model.Sessions)
                            {
                                var cell = p.SessionCells.TryGetValue(s.Id, out var value)
                                    ? value
                                    : Apilan.ViewModels.SessionAttendanceCell.None;

                                <td class="num mono nowrap" title="@cell.ShortLabel">
                                    @if (cell.Attended && cell.TimeIn.HasValue)
                                    {
                                        <span class="@(cell.Status == AttendanceStatus.Late ? "is-late" : "")">
                                            @cell.TimeIn.Value.ToString("h:mm tt")
                                        </span>
                                    }
                                    else if (cell.Status == AttendanceStatus.Absent)
                                    {
                                        <span class="chip risk">Absent</span>
                                    }
                                    else
                                    {
                                        <span class="dim">—</span>
                                    }
                                </td>
                            }
                            <td class="num mono">
                                @p.Attended / @p.Sessions
                                @if (p.Late > 0)
                                {
                                    <div class="dim" style="font-size:var(--fs-2xs)">@p.Late late</div>
                                }
                            </td>
                            <td><span class="chip @AttendanceRules.Chip(p.Eligibility)">@AttendanceRules.Label(p.Eligibility)</span></td>
                            <td class="num mono">
                                @(p.FeedbackRating.HasValue ? p.FeedbackRating.Value.ToString("0.0") : "—")
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div class="report-note">
                    A time means they turned up; a bold time means they were past that
                    session's grace period. "Absent" is an officer's own record that the
                    person did not come; a dash means nobody accounted for them either way.
                    Waitlisted and cancelled registrations are left out — they never held a slot.
                </div>
            }
        </div>

        <div class="panel">
            <div class="panel-head">
                <h2>Per session</h2>
            </div>
            <table class="table-a">
                <thead>
                    <tr>
                        <th>Session</th>
                        <th>When</th>
                        <th class="num">Present</th>
                        <th style="width:180px">Share of registered</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in Model.Sessions)
                {
                    var share = Model.Registered <= 0 ? 0 : (int)Math.Round(s.Present * 100.0 / Model.Registered);
                    <tr>
                        <td><strong>@s.Name</strong></td>
                        <td class="mono nowrap">@s.TimeRange</td>
                        <td class="num mono">@s.Present</td>
                        <td>
                            <div class="bar-cell">
                                <div class="meter"><i style="width:@share%"></i></div>
                                <span class="pct">@share%</span>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="rail">
        <div class="panel">
            <div class="panel-head"><h3>The event</h3></div>
            <div class="panel-body">
                <dl class="detail-list" style="grid-template-columns:1fr">
                    <div><dt>Type</dt><dd><span class="swatch" data-type="@e.EventType?.ColorKey"></span>@e.EventType?.Name</dd></div>
                    <div><dt>When</dt><dd>@e.StartsAt.ToString("dddd, d MMM yyyy")<div class="dim" style="font-size:var(--fs-2xs)">@e.StartsAt.ToString("h:mm tt") – @e.EndsAt.ToString("h:mm tt")</div></dd></div>
                    <div><dt>Venue</dt><dd>@e.Venue?.Name</dd></div>
                    <div><dt>Capacity</dt><dd>@Model.Registered of @e.Capacity taken</dd></div>
                    <div><dt>Status</dt><dd><span class="chip @(e.Status == EventStatus.Completed ? "ok" : "warn")">@e.Status</span></dd></div>
                </dl>
            </div>
        </div>

        <div class="panel">
            <div class="panel-head"><h3>By course</h3></div>
            <table class="table-a">
                <tbody>
                @foreach (var b in Model.ByCourse)
                {
                    <tr>
                        <td><strong>@b.Label</strong></td>
                        <td class="num mono">@b.Attended/@b.Registered</td>
                        <td style="width:80px">
                            <div class="meter"><i style="width:@(b.Percent)%"></i></div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="panel">
            <div class="panel-head"><h3>By year level</h3></div>
            <table class="table-a">
                <tbody>
                @foreach (var b in Model.ByYear)
                {
                    <tr>
                        <td><strong>@b.Label</strong></td>
                        <td class="num mono">@b.Attended/@b.Registered</td>
                        <td style="width:80px">
                            <div class="meter"><i style="width:@(b.Percent)%"></i></div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
