@model Apilan.ViewModels.DoorViewModel
@{
    var e = Model.Event;
    ViewData["Title"] = "Door · " + e.Title;
    ViewData["Module"] = "Transactions · Check-in";
    Layout = "_LayoutAdmin";

    var session = Model.Session;
}

@section Actions {
    <a class="btn-a ghost sm" asp-action="Index">Other events</a>
    <a class="btn-a ghost sm" asp-controller="Events" asp-action="Details" asp-route-id="@e.Id">Event</a>
}

<div class="toolbar">
    <div class="segmented">
        @foreach (var s in Model.Sessions)
        {
            <a class="@(s.Id == session.Id ? "is-active" : "")"
               asp-action="Door" asp-route-id="@e.Id" asp-route-sessionId="@s.Id">
                @s.Name@(s.IsNow ? " ·" : "")
            </a>
        }
    </div>
    <span class="grow"></span>
    <span class="count mono">@session.StartsAt.ToString("ddd d MMM · h:mm tt") – @session.EndsAt.ToString("h:mm tt")</span>
</div>

<div class="door-console">

    <div class="scan-pad">
        <div class="panel">
            <div class="panel-head"><h3>Scan or type a code</h3></div>
            <div class="panel-body">
                <form asp-action="Scan" asp-route-id="@e.Id" method="post" autocomplete="off" id="scan-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="sessionId" value="@session.Id" />

                    @*
                        How the person got in, recorded honestly: the camera
                        scanner sets this to QrCode before submitting, a
                        hardware wedge leaves it as typed. Guessing here is
                        what made the old "recorded by" column meaningless.
                    *@
                    <input type="hidden" name="method" value="@CheckInMethod.ManualSearch" id="scan-method" />

                    <input class="input-a scan-input" type="text" name="code" id="scan-field"
                           placeholder="APL-0000 or 2024-01234" aria-label="Check-in code or student number" autofocus />

                    <button type="submit" class="btn-a" style="width:100%; margin-top:var(--s-3)">Record</button>
                    <span class="hint">
                        Takes a check-in code or a student number. Scanning someone already
                        inside times them out. The field clears itself after every entry.
                    </span>
                </form>

                <div class="scan-cam" id="scan-cam" hidden>
                    <video id="scan-video" playsinline muted></video>
                    <button type="button" class="btn-a quiet sm" id="scan-stop">Stop the camera</button>
                </div>

                <button type="button" class="btn-a ghost sm" id="scan-start"
                        style="width:100%; margin-top:var(--s-3)" hidden>
                    Use the camera
                </button>

                <span class="hint" id="scan-cam-note" hidden></span>
            </div>
        </div>

        @if (Model.Feedback is { } f)
        {
            <div class="scan-result @f.Tone" role="status" aria-live="polite">
                <div class="who">@f.Headline</div>
                @if (!string.IsNullOrWhiteSpace(f.Detail))
                {
                    <div class="sub">@f.Detail</div>
                }
                @if (!string.IsNullOrWhiteSpace(f.Code))
                {
                    <div class="sub"><span class="code-tag">@f.Code</span></div>
                }
            </div>
        }

        <div class="panel">
            <div class="panel-body">
                <span class="l dim" style="font-size:var(--fs-3xs); letter-spacing:var(--tracking-wide); text-transform:uppercase">This session</span>
                <div class="big-count">
                    <span class="n">@Model.AttendedCount</span>
                    <span class="of">/ @Model.ExpectedCount expected</span>
                </div>
                <div class="meter" style="margin-top:var(--s-3)"><i style="width:@(Model.PresentPercent)%"></i></div>

                <div class="door-tally">
                    <span><span class="chip ok">@Model.PresentCount</span> on time</span>
                    <span><span class="chip warn">@Model.LateCount</span> late</span>
                    <span><span class="chip risk">@Model.AbsentCount</span> absent</span>
                    <span><span class="chip idle">@Model.UnaccountedCount</span> no record</span>
                </div>

                <div class="dim" style="font-size:var(--fs-2xs); margin-top:var(--s-3)">
                    @Model.StillInCount still inside · @Model.WalkInCount walk-in@(Model.WalkInCount == 1 ? "" : "s")
                    <br />
                    On time until @session.LateThreshold.ToString("h:mm tt")
                    (@session.LateAfterMinutes min grace)
                </div>
            </div>
        </div>

        @if (Model.UnaccountedCount > 0)
        {
            <div class="panel">
                <div class="panel-body">
                    <form asp-action="CloseSession" asp-route-id="@e.Id" method="post"
                          onsubmit="return confirm('Mark all @Model.UnaccountedCount remaining as absent for @session.Name?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sessionId" value="@session.Id" />
                        <button type="submit" class="btn-a ghost" style="width:100%">
                            Close the session
                        </button>
                        <span class="hint">
                            Marks the @Model.UnaccountedCount people with no record yet as absent,
                            so the report says they did not come rather than saying nothing.
                        </span>
                    </form>
                </div>
            </div>
        }
    </div>

    <div style="display:grid; gap:var(--s-5)">

        <div class="panel">
            <div class="panel-head">
                <h2>Recorded</h2>
                <span class="dim">@Model.Feed.Count in this session</span>
            </div>

            @if (!Model.Feed.Any())
            {
                <div class="panel-body">
                    <p class="muted">Nobody has been recorded for @session.Name yet.</p>
                </div>
            }
            else
            {
                <table class="table-a">
                    <thead>
                        <tr>
                            <th>Participant</th>
                            <th>Code</th>
                            <th>In</th>
                            <th>Out</th>
                            <th>Verdict</th>
                            <th>How</th>
                            <th style="width:1%"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.Feed)
                    {
                        <tr>
                            <td>
                                <strong>@r.ListName</strong>
                                <div class="dim" style="font-size:var(--fs-2xs)">
                                    @r.StudentNumber@(r.IsWalkIn ? " · walk-in" : "")
                                </div>
                            </td>
                            <td><span class="code-tag">@r.Code</span></td>
                            <td class="mono nowrap">@r.TimeIn?.ToString("h:mm tt")</td>
                            <td class="mono nowrap">
                                @if (r.TimeOut.HasValue)
                                {
                                    @r.TimeOut.Value.ToString("h:mm tt")
                                }
                                else
                                {
                                    <span class="chip ok">inside</span>
                                }
                            </td>
                            <td>
                                <span class="chip @r.StatusChip">@r.StatusLabel</span>
                                @if (!string.IsNullOrWhiteSpace(r.Note))
                                {
                                    <div class="dim" style="font-size:var(--fs-2xs)">@r.Note</div>
                                }
                            </td>
                            <td class="dim" style="font-size:var(--fs-2xs)">@r.Method</td>
                            <td>
                                <div class="row-actions">
                                    @*
                                        One button to flip the verdict the other way. A
                                        latecomer held up at the gate is a judgement the
                                        officer at the door is the only one able to make.
                                    *@
                                    <form asp-action="SetStatus" asp-route-id="@e.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sessionId" value="@session.Id" />
                                        <input type="hidden" name="attendanceId" value="@r.AttendanceId" />
                                        <input type="hidden" name="status"
                                               value="@(r.IsLate ? AttendanceStatus.Present : AttendanceStatus.Late)" />
                                        <button type="submit" class="btn-a quiet sm">
                                            @(r.IsLate ? "Excuse the delay" : "Mark late")
                                        </button>
                                    </form>

                                    @if (!r.TimeOut.HasValue)
                                    {
                                        <form asp-action="TimeOut" asp-route-id="@e.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="sessionId" value="@session.Id" />
                                            <input type="hidden" name="attendanceId" value="@r.AttendanceId" />
                                            <button type="submit" class="btn-a ghost sm">Time out</button>
                                        </form>
                                    }

                                    <form asp-action="Undo" asp-route-id="@e.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sessionId" value="@session.Id" />
                                        <input type="hidden" name="attendanceId" value="@r.AttendanceId" />
                                        <button type="submit" class="btn-a quiet sm">Undo</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>

        <div class="panel">
            <div class="panel-head">
                <h2>Still expected</h2>
                <form method="get" asp-action="Door" style="display:flex; gap:var(--s-2)">
                    <input type="hidden" name="id" value="@e.Id" />
                    <input type="hidden" name="sessionId" value="@session.Id" />
                    <input class="input-a" type="search" name="search" value="@Model.Search"
                           placeholder="Name, student no., or code" />
                    <button type="submit" class="btn-a ghost sm">Find</button>
                </form>
            </div>

            @if (!Model.Expected.Any())
            {
                <div class="panel-body">
                    <p class="muted">Everyone on the roster has been accounted for.</p>
                </div>
            }
            else
            {
                <table class="table-a">
                    <thead>
                        <tr>
                            <th>Participant</th>
                            <th>Code</th>
                            <th>Registration</th>
                            <th>This session</th>
                            <th style="width:1%"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.Expected)
                    {
                        <tr>
                            <td>
                                <strong>@r.ListName</strong>
                                <div class="dim" style="font-size:var(--fs-2xs)">@r.StudentNumber · @r.CourseYear</div>
                            </td>
                            <td><span class="code-tag">@r.Code</span></td>
                            <td>
                                <span class="chip @(r.Status switch {
                                    RegistrationStatus.Confirmed => "ok",
                                    RegistrationStatus.Pending => "info",
                                    _ => "warn" })">@r.Status</span>
                            </td>
                            <td>
                                <span class="chip @r.StatusChip">@r.StatusLabel</span>
                                @if (!string.IsNullOrWhiteSpace(r.Note))
                                {
                                    <div class="dim" style="font-size:var(--fs-2xs)">@r.Note</div>
                                }
                            </td>
                            <td>
                                <div class="row-actions">
                                    @if (r.Status != RegistrationStatus.Waitlisted)
                                    {
                                        <form asp-action="Mark" asp-route-id="@e.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="sessionId" value="@session.Id" />
                                            <input type="hidden" name="registrationId" value="@r.RegistrationId" />
                                            <button type="submit" class="btn-a sm">Mark present</button>
                                        </form>

                                        @if (r.IsAbsent && r.AttendanceId.HasValue)
                                        {
                                            @* Written off in error, or never actually asked. *@
                                            <form asp-action="Undo" asp-route-id="@e.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="sessionId" value="@session.Id" />
                                                <input type="hidden" name="attendanceId" value="@r.AttendanceId" />
                                                <button type="submit" class="btn-a quiet sm">Clear absence</button>
                                            </form>
                                        }
                                        else if (r.IsUnaccounted)
                                        {
                                            <form asp-action="MarkAbsent" asp-route-id="@e.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="sessionId" value="@session.Id" />
                                                <input type="hidden" name="registrationId" value="@r.RegistrationId" />
                                                <button type="submit" class="btn-a quiet sm">Mark absent</button>
                                            </form>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div class="report-note">
                    Marking someone present by hand is recorded as a manual check-in, so the
                    trail shows how each person got in. Somebody marked absent who then turns
                    up can simply be scanned — the absence becomes the arrival.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/scanner.js" asp-append-version="true"></script>
    <script>
        (function () {
            // The door is a keyboard-first screen: the code field keeps focus
            // between people so a hardware scanner can fire straight into it.
            var field = document.getElementById("scan-field");
            if (!field) { return; }

            field.focus();

            document.addEventListener("click", function (e) {
                if (e.target.closest("form, a, button, input, select, textarea")) { return; }
                field.focus();
            });

            // Camera scanning, where the browser can do it.
            if (window.ApilanScanner) {
                window.ApilanScanner.attach({
                    form: document.getElementById("scan-form"),
                    field: field,
                    method: document.getElementById("scan-method"),
                    video: document.getElementById("scan-video"),
                    shell: document.getElementById("scan-cam"),
                    start: document.getElementById("scan-start"),
                    stop: document.getElementById("scan-stop"),
                    note: document.getElementById("scan-cam-note")
                });
            }
        })();
    </script>
}
