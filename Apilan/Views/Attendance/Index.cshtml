@model Apilan.ViewModels.AttendancePickerViewModel
@{
    ViewData["Title"] = "Check-in";
    ViewData["Module"] = "Transactions";
    Layout = "_LayoutAdmin";
}

@functions {
    string Fill(Apilan.ViewModels.AttendanceEventOption o) =>
        o.Expected <= 0 ? "0" : Math.Min(100, (int)Math.Round(o.Present * 100.0 / o.Expected)).ToString();
}

@if (!Model.Today.Any() && !Model.Upcoming.Any() && !Model.Recent.Any())
{
    <div class="empty-a">
        <h4>No events to check people into</h4>
        <p>Publish an event with at least one session, and its door opens here.</p>
        <a class="btn-a" style="margin-top:var(--s-4)" asp-controller="Events" asp-action="Index">Go to events</a>
    </div>
}

@foreach (var group in new[]
{
    ("Happening today", Model.Today),
    ("Coming up", Model.Upcoming),
    ("Recently finished", Model.Recent)
})
{
    if (!group.Item2.Any())
    {
        continue;
    }

    <div class="panel">
        <div class="panel-head">
            <h2>@group.Item1</h2>
            <span class="dim">@group.Item2.Count event@(group.Item2.Count == 1 ? "" : "s")</span>
        </div>
        <table class="table-a">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>When</th>
                    <th>Where</th>
                    <th class="num">Sessions</th>
                    <th style="width:200px">Turnout</th>
                    <th style="width:1%"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var o in group.Item2)
            {
                <tr>
                    <td>
                        <strong><span class="swatch" data-type="@o.ColorKey"></span>@o.Title</strong>
                        <div class="dim" style="font-size:var(--fs-2xs)">@o.Status</div>
                    </td>
                    <td class="mono nowrap">@o.StartsAt.ToString("ddd d MMM · h:mm tt")</td>
                    <td>@o.VenueName</td>
                    <td class="num mono">@o.Sessions</td>
                    <td>
                        <div class="bar-cell">
                            <div class="meter"><i style="width:@(Fill(o))%"></i></div>
                            <span class="pct">@o.Present/@o.Expected</span>
                        </div>
                    </td>
                    <td>
                        @if (o.Sessions > 0)
                        {
                            <a class="btn-a sm" asp-action="Door" asp-route-id="@o.EventId">Open the door</a>
                        }
                        else
                        {
                            <a class="btn-a ghost sm" asp-controller="Events" asp-action="Edit" asp-route-id="@o.EventId">Add sessions</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
