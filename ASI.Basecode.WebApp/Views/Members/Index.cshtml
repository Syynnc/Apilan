@model StudentListViewModel
@{
    ViewData["Title"] = "Members";
    ViewData["Module"] = "Master data";
}

@section Actions {
    <a class="btn-a" asp-action="Create" data-modal>
        <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        New member
    </a>
}

<div class="stack">
    <form method="get" class="toolbar" role="search">
        <div class="searchbar">
            <svg class="s-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4.2-4.2" /></svg>
            <input type="search" name="search" id="member-search" value="@Model.Search" class="input-a"
                   placeholder="Search by name, student no., or course…" aria-label="Search members"
                   data-live-search data-target="#members-table" data-suggest="@Url.Action("Suggest")" />
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <a class="s-clear" asp-action="Index" asp-route-showInactive="@Model.ShowInactive" aria-label="Clear the search" title="Clear">×</a>
            }
            <button type="submit" class="btn-a s-go">Search <kbd aria-hidden="true">↵</kbd></button>
        </div>
        <label class="switch">
            <input type="checkbox" name="showInactive" value="true" @(Model.ShowInactive ? "checked" : "") onchange="this.form.submit()" />
            <span class="switch-track" aria-hidden="true"></span>
            Show deactivated
        </label>
        <span class="count">@Model.Students.Count member@(Model.Students.Count == 1 ? "" : "s")</span>
    </form>

    <div class="panel">
        @if (!Model.Students.Any())
        {
            <div class="panel-body"><div class="empty-a"><div class="glyph">◎</div><h4>No members</h4><p>Add one, or widen the search.</p></div></div>
        }
        else
        {
            <table class="table-a" id="members-table" data-paginate="5">
                <thead>
                    <tr><th>Name</th><th>Student no.</th><th>Course</th><th class="num">Year</th><th class="num">Attended</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var m in Model.Students)
                {
                    <tr data-search="@m.FullName @m.StudentNumber @m.Course" class="@(m.IsActive ? null : "is-off")">
                        <td>
                            <div class="cell-person">
                                <span class="av" aria-hidden="true">@Ui.Initials(m.FullName.Contains(',') ? m.FullName.Split(',')[1] + " " + m.FullName.Split(',')[0] : m.FullName)</span>
                                <a asp-action="Details" asp-route-id="@m.Id"><strong>@m.FullName</strong></a>
                            </div>
                        </td>
                        <td class="mono">@m.StudentNumber</td>
                        <td>@(string.IsNullOrEmpty(m.Course) ? "—" : m.Course)</td>
                        <td class="num">@YearLevels.Short(m.YearLevel)</td>
                        <td class="num">@m.EventsAttended</td>
                        <td>
                            @if (m.IsActive)
                            {
                                <span class="chip ok">Active</span>
                            }
                            else
                            {
                                <span class="chip risk">Deactivated</span>
                            }
                        </td>
                        <td>
                            <div class="row-actions">
                                <a class="btn-a quiet sm" asp-action="Edit" asp-route-id="@m.Id" data-modal>Edit</a>
                                <form asp-action="SetActive" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <input type="hidden" name="isActive" value="@((!m.IsActive).ToString().ToLower())" />
                                    <button type="submit" class="btn-a quiet sm">@(m.IsActive ? "Deactivate" : "Restore")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
