@model ChangePasswordViewModel
@*
    The password form as a ticket: fields on the body, a lock on the stub
    that closes as the new password gets stronger. Used by the
    change-password page and by the first-sign-in prompt in the layouts.
*@
@{
    var first = Model.FirstSignIn;
    var username = User.Identity?.Name ?? string.Empty;
}

<form asp-controller="Account" asp-action="ChangePassword" method="post" novalidate
      class="ticket ticket-form narrow pw-ticket" data-type="training" data-modal-form
      aria-labelledby="pw-title">
    <input type="hidden" asp-for="FirstSignIn" />
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="ticket-body">
        <header class="tf-head">
            <div class="ticket-kicker">
                <span class="ticket-type">@(first ? "First sign-in" : "Security")</span>
                <span class="ticket-org">@Apilan.Value.SchoolShortName</span>
            </div>
            <h2 class="ticket-title" id="pw-title">@(first ? "Make this account yours." : "Change your password")</h2>
            @if (!first)
            {
                <button type="button" class="tf-close" data-modal-close aria-label="Close">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
            }
        </header>

        @if (first)
        {
            <p class="pw-notice">
                You signed in with the <strong>default password</strong>, which other people may know.
                Choose your own before you continue — you will use it from now on.
            </p>
        }

        <div asp-validation-summary="ModelOnly" class="tf-alert"></div>

        <div class="tf-grid">
            @if (!first)
            {
                <div class="field span-4">
                    <label asp-for="CurrentPassword" class="req"></label>
                    <div class="pw-field">
                        <input asp-for="CurrentPassword" class="input-a" type="password" autocomplete="current-password" autofocus />
                        <button type="button" class="pw-eye" data-reveal aria-label="Show password"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg></button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="field-error"></span>
                </div>
            }

            <div class="field span-4">
                <label asp-for="NewPassword" class="req"></label>
                <div class="pw-field">
                    <input asp-for="NewPassword" class="input-a" type="password" autocomplete="new-password"
                           data-strength data-strength-user="@username" data-strength-default="@Apilan.Value.DefaultPassword"
                           aria-describedby="pw-meter-label" autofocus="@first" />
                    <button type="button" class="pw-eye" data-reveal aria-label="Show password"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg></button>
                </div>

                <div class="pw-meter" data-strength-meter data-score="0" aria-live="polite">
                    <div class="pw-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                    <span class="pw-label" id="pw-meter-label">Type a password</span>
                </div>
                <ul class="pw-rules" data-strength-rules>
                    <li data-rule="length">At least 8 characters</li>
                    <li data-rule="mix">Letters and numbers</li>
                    <li data-rule="case">Upper and lower case</li>
                    <li data-rule="symbol">A symbol, like ! or #</li>
                    <li data-rule="fresh">Not the default or your username</li>
                </ul>
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>

            <div class="field span-4">
                <label asp-for="ConfirmPassword" class="req"></label>
                <div class="pw-field">
                    <input asp-for="ConfirmPassword" class="input-a" type="password" autocomplete="new-password" data-strength-confirm />
                    <span class="pw-match" aria-hidden="true"></span>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
        </div>

        <footer class="tf-foot">
            @if (first)
            {
                <button type="submit" class="btn-a ghost" form="pw-signout">Sign out instead</button>
            }
            else
            {
                <span class="tf-legend"><i aria-hidden="true">*</i> Required</span>
                <a class="btn-a ghost" asp-controller="Home" asp-action="Index" data-modal-close>Cancel</a>
            }
            <button type="submit" class="btn-a" data-strength-submit>@(first ? "Save and continue" : "Update password")</button>
        </footer>
    </div>

    <aside class="ticket-stub tf-stub pw-stub" aria-hidden="true">
        <svg class="pw-lock" viewBox="0 0 64 64">
            <path class="shackle" d="M20 30v-8a12 12 0 0 1 24 0v8" />
            <rect class="body" x="14" y="30" width="36" height="26" rx="5" />
            <circle class="key" cx="32" cy="41" r="3.2" />
            <path class="key" d="M32 44v5" />
        </svg>
        <span class="stub-code pw-word" data-strength-word>—</span>
        <span class="stub-note">Password<br />strength</span>
    </aside>
</form>

@* Outside the ticket: a form cannot sit inside another form. *@
@if (first)
{
    <form id="pw-signout" asp-controller="Account" asp-action="Logout" method="post" hidden>
        @Html.AntiForgeryToken()
    </form>
}
