@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
    ViewData["Module"] = "Account";
    Layout = User.IsInRole(Const.RoleOfficer) ? "_Layout" : "_LayoutMember";
}

<div class="pw-page">
    <div class="pw-page-copy">
        <span class="tag-pill"><b>Security</b> Your sign-in</span>
        <h1 class="pw-page-title">Keep your <em class="display-em">pass</em> yours.</h1>
        <p>
            Your password guards your attendance record and your QR pass. Pick one you do not use
            anywhere else — the meter shows how hard it would be to guess.
        </p>
        <ul class="pw-tips">
            <li>Long beats clever: three or four unrelated words work well.</li>
            <li>Never share it — officers can reset it for you if you forget.</li>
            <li>You stay signed in here after changing it.</li>
        </ul>
    </div>

    <div class="form-page">
        <partial name="_PasswordForm" model="Model" />
    </div>
</div>
