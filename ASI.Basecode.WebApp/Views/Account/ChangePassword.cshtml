@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
    ViewData["Module"] = "Account";
    Layout = User.IsInRole(Const.RoleOfficer) ? "_Layout" : "_LayoutMember";
}

<div class="panel" style="max-width:520px">
    <div class="panel-head"><h2>Change password</h2></div>
    <div class="panel-body">
        <form asp-action="ChangePassword" method="post" class="stack" novalidate>
            <div asp-validation-summary="ModelOnly" class="field-error"></div>

            <div class="field">
                <label asp-for="CurrentPassword"></label>
                <input asp-for="CurrentPassword" class="input-a" type="password" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" class="input-a" type="password" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="input-a" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <div class="form-foot">
                <button type="submit" class="btn-a">Update password</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
