@model EventTypeViewModel
@*
    The event type form as a ticket. The stub shows the colour every event of
    this type will carry on its ticket, picked from the name as you type.
*@
@{
    var isNew = Model.Id == 0;
}

<form asp-controller="EventTypes" asp-action="Save" method="post" novalidate
      class="ticket ticket-form narrow" data-type="@Ui.TicketType(Model.TypeName)" data-modal-form
      data-tone-from="TypeName" aria-labelledby="type-form-title">
    <input type="hidden" asp-for="Id" />

    <div class="ticket-body">
        <header class="tf-head">
            <div class="ticket-kicker">
                <span class="ticket-type">@(isNew ? "New event type" : "Edit event type")</span>
                <span class="ticket-org">Master data</span>
            </div>
            <h2 class="ticket-title" id="type-form-title"
                data-preview="TypeName" data-empty="@(isNew ? "Name this type" : "Edit type")">
                @(isNew ? "Name this type" : Model.TypeName)
            </h2>
            <button type="button" class="tf-close" data-modal-close aria-label="Close">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
        </header>

        <div asp-validation-summary="ModelOnly" class="tf-alert"></div>

        <div class="tf-grid">
            <div class="field span-4">
                <label asp-for="TypeName" class="req"></label>
                <input asp-for="TypeName" class="input-a" placeholder="Seminar, Workshop, Outreach…" autofocus />
                <span asp-validation-for="TypeName" class="field-error"></span>
            </div>
            <div class="field span-4">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="input-a" rows="3" placeholder="What kind of event this is, in a line."></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>
            <div class="field span-4">
                <label class="switch">
                    <input asp-for="IsActive" type="checkbox" />
                    <span class="switch-track" aria-hidden="true"></span>
                    Active — offered when creating an event
                </label>
            </div>
        </div>

        <footer class="tf-foot">
            <span class="tf-legend"><i aria-hidden="true">*</i> Required</span>
            <a class="btn-a ghost" asp-action="Index" data-modal-close>Cancel</a>
            <button type="submit" class="btn-a">@(isNew ? "Create type" : "Save changes")</button>
        </footer>
    </div>

    <aside class="ticket-stub tf-stub" aria-hidden="true">
        <span class="tf-swatch"></span>
        <span class="stub-code" data-preview="TypeName" data-empty="TYPE">@(Model.TypeName ?? "TYPE")</span>
        <span class="stub-note">Ticket<br />colour</span>
    </aside>
</form>
