@model List<ASI.Basecode.Data.Models.AttendanceDetail>

<div class="panel">
    <div class="panel-head"><h3>Attendance history</h3><span class="count">@Model.Count</span></div>
    @if (!Model.Any())
    {
        <div class="panel-body"><div class="empty-a"><h4>No attendance yet</h4><p>Events attended will appear here.</p></div></div>
    }
    else
    {
        @* table-stack: on a phone each row becomes a small card, labelled from data-label. *@
        <table class="table-a table-stack">
            <thead>
                <tr><th>Event</th><th>When</th><th>Mode</th><th>Time in</th><th>Time out</th><th>Arrival</th></tr>
            </thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td class="cell-title"><strong>@a.EventName</strong><br /><span class="dim">@a.EventType</span></td>
                    <td class="mono" data-label="When">@a.EventStart.ToString("yyyy-MM-dd")</td>
                    <td data-label="Mode">@a.AttendanceMode</td>
                    <td class="mono" data-label="Time in">@a.TimeIn.ToString("HH:mm")</td>
                    <td class="mono" data-label="Time out">@(a.TimeOut?.ToString("HH:mm") ?? "—")</td>
                    <td data-label="Arrival">@if (a.IsLate == 1) { <span class="chip warn">Late</span> } else { <span class="chip ok">On time</span> }</td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
