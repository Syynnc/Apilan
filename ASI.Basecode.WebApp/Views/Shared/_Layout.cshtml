@using System.Security.Claims
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    Func<string, string> nav = name =>
        controller.Equals(name, StringComparison.OrdinalIgnoreCase) ? "side-link is-active" : "side-link";

    var displayName = User.FindFirstValue(Const.ClaimDisplayName) ?? User.Identity?.Name ?? "Signed in";
    var initials = string.Concat(displayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(w => char.ToUpperInvariant(w[0])));
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Apilan</title>
    <meta name="theme-color" content="#F7F5EF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101210" media="(prefers-color-scheme: dark)" />

    <script>
        (function () {
            try {
                var s = localStorage.getItem("apilan-theme");
                var t = s || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
                document.documentElement.setAttribute("data-theme", t);
                if (localStorage.getItem("apilan-side") === "collapsed") {
                    document.documentElement.setAttribute("data-side", "collapsed");
                }
            } catch (e) { }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Fraunces:ital,opsz,wght@0,9..144,600;1,9..144,600&display=swap" />

    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/screens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/console.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
@await Html.PartialAsync("_CalendarBackdrop")

<div class="console">

    <aside class="side" id="side-nav">
        <div class="side-head">
            <a class="brand" asp-controller="Dashboard" asp-action="Index" title="Apilan">
                <svg class="tally" viewBox="0 0 26 24" aria-hidden="true">
                    <line x1="4"  y1="5" x2="4"  y2="19" />
                    <line x1="9"  y1="5" x2="9"  y2="19" />
                    <line x1="14" y1="5" x2="14" y2="19" />
                    <line x1="19" y1="5" x2="19" y2="19" />
                    <line class="slash" x1="1.5" y1="18.5" x2="21.5" y2="5.5" />
                </svg>
                <span class="lbl">Apilan</span>
            </a>

            <button type="button" class="side-toggle" data-side-toggle
                    aria-controls="side-nav" aria-expanded="true">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="16" rx="2" />
                    <path d="M9 4v16" />
                    <path class="caret" d="M15.5 9.5 13 12l2.5 2.5" />
                </svg>
                <span class="visually-hidden">Collapse the sidebar</span>
            </button>
        </div>

        <div class="side-org" title="@Apilan.Value.SchoolName">
            <span class="org">@Apilan.Value.OrganizationName</span>
            <span class="school">@Apilan.Value.SchoolShortName</span>
        </div>

        <nav class="side-group">
            <h6>Transactions</h6>
            <a class="@nav("Dashboard")" title="Dashboard" asp-controller="Dashboard" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="8" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="11" width="7" height="10" rx="1.5"/></svg>
                <span class="lbl">Dashboard</span>
            </a>
            <a class="@nav("Events")" title="Events" asp-controller="Events" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
                <span class="lbl">Events</span>
            </a>
        </nav>

        <nav class="side-group">
            <h6>Master data</h6>
            <a class="@nav("Members")" title="Members" asp-controller="Members" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19c1.2-3 3.2-4.5 5.5-4.5S13.3 16 14.5 19M17 8h4M17 12h4"/></svg>
                <span class="lbl">Members</span>
            </a>
            <a class="@nav("EventTypes")" title="Event types" asp-controller="EventTypes" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
                <span class="lbl">Event types</span>
            </a>
        </nav>

        <nav class="side-group">
            <h6>Reports</h6>
            <a class="@nav("Reports")" title="Participation" asp-controller="Reports" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V4M4 20h16M8 20v-6M13 20v-10M18 20v-4"/></svg>
                <span class="lbl">Participation</span>
            </a>
        </nav>

        <nav class="side-group">
            <h6>Administration</h6>
            <a class="@((controller == "Account" && (ViewContext.RouteData.Values["action"] as string) != "ChangePassword") ? "side-link is-active" : "side-link")" title="Accounts" asp-controller="Account" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="8" r="3.2"/><path d="M4 19c1.3-3 3.4-4.5 6-4.5M17 13v6M14 16h6"/></svg>
                <span class="lbl">Accounts</span>
            </a>
        </nav>

        <div class="side-foot">
            @* Your own account: the details and the change-password action
               open from here, where people look for them. *@
            <button type="button" class="side-user" popovertarget="account-pop"
                    aria-haspopup="true" aria-expanded="false" title="Your account">
                <span class="av" aria-hidden="true">@initials</span>
                <span class="who">
                    <span class="nm">@displayName</span>
                    <span class="rl">Officer</span>
                </span>
                <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 10l4-4 4 4M8 14l4 4 4-4" /></svg>
            </button>

            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-a ghost sm side-out" title="Sign out">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4" />
                        <path d="M10 8l-4 4 4 4M6 12h10" />
                    </svg>
                    <span class="lbl">Sign out</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="console-main">
        <header class="console-bar">
            <div class="titles">
                <div class="crumb">@ViewData["Module"]</div>
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="actions">
                @await RenderSectionAsync("Actions", required: false)
                <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Switch theme">
                    <svg class="tt-icon tt-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                    </svg>
                    <svg class="tt-icon tt-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </svg>
                    <span class="tt-label"></span>
                </button>
            </div>
        </header>

        <main class="console-body">
            @if (TempData["Success"] is string ok)
            {
                <div class="flash ok"><strong>Done.</strong> @ok</div>
            }
            @if (TempData["Error"] is string bad)
            {
                <div class="flash bad"><strong>Not done.</strong> @bad</div>
            }

            @RenderBody()
        </main>
    </div>

</div>

@* One modal for every add/edit form; modal.js loads the form into it. *@
<dialog class="modal" id="app-modal" aria-label="Form">
    <div class="modal-content"></div>
</dialog>

<div class="account-pop" id="account-pop" popover role="menu" aria-label="Your account">
    <div class="ap-head">
        <span class="av" aria-hidden="true">@initials</span>
        <span class="who">
            <span class="nm">@displayName</span>
            <span class="un">@User.Identity?.Name</span>
        </span>
    </div>
    <dl class="ap-meta">
        <div><dt>Role</dt><dd>Officer</dd></div>
        <div><dt>Organization</dt><dd>@Apilan.Value.OrganizationName · @Apilan.Value.SchoolShortName</dd></div>
    </dl>
    <div class="ap-actions">
        <a class="ap-item" role="menuitem" data-modal
           asp-controller="Account" asp-action="ChangePassword"
           asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v2"/></svg>
            <span>Change password</span>
            <svg class="go" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 7l5 5-5 5"/></svg>
        </a>
    </div>
</div>

<partial name="_FirstPasswordPrompt" />

<partial name="_ValidationScriptsPartial" />
<script src="~/js/theme.js" asp-append-version="true"></script>
<script src="~/js/console.js" asp-append-version="true"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
<script src="~/js/tables.js" asp-append-version="true"></script>
<script src="~/js/modal.js" asp-append-version="true"></script>
<script src="~/js/password.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
