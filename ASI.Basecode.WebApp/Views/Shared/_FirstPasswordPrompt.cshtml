@*
    Shown on every page while the account is still on the default password
    (the MustChangePassword claim, set at sign-in). It cannot be dismissed:
    the only ways out are a new password or signing out.
*@
@{
    var mustChange = User.HasClaim(c => c.Type == Const.ClaimMustChangePassword);
    var onPasswordPage = string.Equals(ViewContext.RouteData.Values["controller"] as string, "Account", StringComparison.OrdinalIgnoreCase)
                      && string.Equals(ViewContext.RouteData.Values["action"] as string, "ChangePassword", StringComparison.OrdinalIgnoreCase);
}
@if (mustChange && !onPasswordPage)
{
    var model = new ChangePasswordViewModel
    {
        FirstSignIn = true,
        ReturnUrl = Context.Request.Path + Context.Request.QueryString,
    };

    <dialog class="modal" id="first-password" data-force data-open-on-load aria-labelledby="pw-title">
        <div class="modal-content">
            <partial name="~/Views/Account/_PasswordForm.cshtml" model="model" />
        </div>
    </dialog>
}
